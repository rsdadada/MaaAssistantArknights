+++ b/src/MaaWpfGui/Models/AsstTasks/AsstOperProgressTask.cs
@@ -28,6 +28,10 @@ public class AsstOperProgressTask : AsstBaseTask
     [JsonProperty("plans")]
     public List<OperProgressTask.Plan> Plans { get; set; } = [];
 
+    public OperProgressTask.SupplyOptions Supply { get; set; } = new();
+
+    public string ProfileId { get; set; } = string.Empty;
+
     public override (AsstTaskType TaskType, JObject Params) Serialize()
     {
         var list = new JArray();
@@ -49,11 +53,39 @@ public class AsstOperProgressTask : AsstBaseTask
             {
                 planObj["skill_mastery"] = JArray.FromObject(p.SkillMastery.ToArray());
             }
+            if (p.TargetLevel is { } target)
+            {
+                planObj["target_level"] = new JObject {
+                    ["elite"] = target.Elite,
+                    ["level"] = target.Level,
+                };
+            }
             list.Add(planObj);
         }
         var jObject = new JObject {
             ["plans"] = list,
         };
+        if (Supply.Enabled)
+        {
+            jObject["supply"] = new JObject {
+                ["enabled"] = true,
+                ["profile_id"] = ProfileId,
+                ["credit"] = SerializePurchaseBudget(Supply.Credit),
+                ["red_voucher"] = SerializePurchaseBudget(Supply.RedVoucher),
+                ["medicine"] = new JObject {
+                    ["enabled"] = Supply.Medicine.Enabled,
+                    ["daily_limit"] = Supply.Medicine.DailyLimit,
+                    ["use_expiring"] = Supply.Medicine.UseExpiring,
+                },
+                ["stage_overrides"] = JObject.FromObject(Supply.StageOverrides),
+            };
+        }
         return (TaskType, jObject);
     }
+
+    private static JObject SerializePurchaseBudget(OperProgressTask.PurchaseBudget budget) => new() {
+        ["enabled"] = budget.Enabled,
+        ["daily_limit"] = budget.DailyLimit,
+        ["reserve"] = budget.Reserve,
+    };
 }
