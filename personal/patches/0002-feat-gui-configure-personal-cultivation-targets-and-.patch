+++ b/tools/PersonalCultivationUiTests/Program.cs
@@ -0,0 +1,85 @@
+// <copyright file="Program.cs" company="MaaAssistantArknights">
+// Part of the MaaWpfGui project, maintained by the MaaAssistantArknights team (Maa Team)
