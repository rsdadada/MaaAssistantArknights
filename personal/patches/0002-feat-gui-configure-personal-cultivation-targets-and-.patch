+
+namespace MaaWpfGui.ViewModels.UserControl.TaskQueue;
+
+public partial class OperProgressTaskUserControlModel
+{
+    public bool EnableSupply
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Enabled;
+        set => SetSupply(options => options with { Enabled = value });
+    }
+
+    public bool BuyWithCredit
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Credit.Enabled;
+        set => SetSupply(options => options with { Credit = options.Credit with { Enabled = value } });
+    }
+
+    public int CreditDailyLimit
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Credit.DailyLimit;
+        set => SetSupply(options => options with { Credit = options.Credit with { DailyLimit = Math.Clamp(value, 0, 999999) } });
+    }
+
+    public int CreditReserve
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Credit.Reserve;
+        set => SetSupply(options => options with { Credit = options.Credit with { Reserve = Math.Clamp(value, 0, 999999) } });
+    }
+
+    public bool BuyWithRedVoucher
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.RedVoucher.Enabled;
+        set => SetSupply(options => options with { RedVoucher = options.RedVoucher with { Enabled = value } });
+    }
+
+    public int RedVoucherDailyLimit
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.RedVoucher.DailyLimit;
+        set => SetSupply(options => options with { RedVoucher = options.RedVoucher with { DailyLimit = Math.Clamp(value, 0, 999999) } });
+    }
+
+    public int RedVoucherReserve
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.RedVoucher.Reserve;
+        set => SetSupply(options => options with { RedVoucher = options.RedVoucher with { Reserve = Math.Clamp(value, 0, 999999) } });
+    }
+
+    public bool SupplyUseMedicine
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Medicine.Enabled;
+        set => SetSupply(options => options with { Medicine = options.Medicine with { Enabled = value } });
+    }
+
+    public int SupplyMedicineDailyLimit
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Medicine.DailyLimit;
+        set => SetSupply(options => options with { Medicine = options.Medicine with { DailyLimit = Math.Clamp(value, 0, 999) } });
+    }
+
+    public bool SupplyUseExpiringMedicine
+    {
+        get => GetTaskConfig<OperProgressTask>().Supply.Medicine.UseExpiring;
+        set => SetSupply(options => options with { Medicine = options.Medicine with { UseExpiring = value } });
+    }
+
+    public List<GenericCombinedData<string>> SupplyMaterials => [
+        new(LocalizationHelper.GetString("PersonalCultivation.Experience"), "__experience"),
+        .. ItemListHelper.ArkItems
+            .Where(pair => pair.Key is not ("2001" or "2002" or "2003" or "2004"))
+            .OrderBy(pair => pair.Value.SortId)
+            .Select(pair => new GenericCombinedData<string>(pair.Value.Name, pair.Key)),
+    ];
+
+    public string SupplyMaterialId { get; set => SetAndNotify(ref field, value); } = string.Empty;
+
+    public string SupplyStage { get; set => SetAndNotify(ref field, value); } = string.Empty;
+
+    public List<StageOverrideItem> SupplyStageOverrides => GetTaskConfig<OperProgressTask>().Supply.StageOverrides
+        .Select(pair => new StageOverrideItem(pair.Key, SupplyItemName(pair.Key), pair.Value))
+        .ToList();
+
+    public record StageOverrideItem(string ItemId, string ItemName, string Stage);
+
+    public void SaveStageOverride()
+    {
+        var stage = SupplyStage.Trim().ToUpperInvariant();
+        if ((SupplyMaterialId != "__experience" && !ItemListHelper.ArkItems.ContainsKey(SupplyMaterialId)) ||
+            !Regex.IsMatch(stage, @"^[A-Z0-9]+(?:-[A-Z0-9]+)+$"))
+        {
+            Instances.TaskQueueViewModel.AddLog(LocalizationHelper.GetString("PersonalCultivation.StageSourceInvalid"), UiLogColor.Warning);
+            return;
+        }
+
+        var sources = new Dictionary<string, string>(GetTaskConfig<OperProgressTask>().Supply.StageOverrides) {
+            [SupplyMaterialId] = stage,
+        };
+        SetSupply(options => options with { StageOverrides = sources }, nameof(SupplyStageOverrides));
+        SupplyStage = stage;
+    }
+
+    public void RemoveStageOverride(StageOverrideItem item)
+    {
+        var sources = new Dictionary<string, string>(GetTaskConfig<OperProgressTask>().Supply.StageOverrides);
+        if (sources.Remove(item.ItemId))
+        {
+            SetSupply(options => options with { StageOverrides = sources }, nameof(SupplyStageOverrides));
+        }
+    }
+
+    public void MoveBeforeFarming()
+    {
+        if (!RunningState.Instance.GetIdle())
+        {
+            return;
+        }
+
+        var tasks = ConfigFactory.CurrentConfig.TaskQueue;
+        var current = TaskSettingVisibilityInfo.Instance.CurrentIndex;
+        if (current < 0 || current >= tasks.Count || tasks[current] is not OperProgressTask)
+        {
+            return;
+        }
+
+        var firstFarming = Enumerable.Range(0, current).FirstOrDefault(index => tasks[index] is FightTask or DepotMaintainTask, -1);
+        if (firstFarming >= 0)
+        {
+            // 复用任务列表的 Move 事件同步配置和选中项，不直接改两份集合。
+            Instances.TaskQueueViewModel.TaskItemViewModels.Move(current, firstFarming);
+            Instances.TaskQueueViewModel.AddLog(LocalizationHelper.GetString("PersonalCultivation.MovedBeforeFarming"), UiLogColor.Info);
+        }
+    }
+
+    private void SetSupply(Func<SupplyOptions, SupplyOptions> update, [CallerMemberName] string propertyName = "")
+    {
+        var next = update(GetTaskConfig<OperProgressTask>().Supply);
+        SetTaskConfig<OperProgressTask>(task => task.Supply == next, task => task.Supply = next, propertyName);
+    }
+
+    private void RefreshSupplySettings()
+    {
+        NotifyOfPropertyChange(nameof(SupplyMaterials));
+        NotifyOfPropertyChange(nameof(SupplyStageOverrides));
+    }
+
+    private static LevelTarget? ParseLevelTarget(JToken? token)
+    {
+        if (token is null)
+        {
+            return null;
+        }
+
+        if (token is not JObject target || target["elite"]?.Type != JTokenType.Integer || target["level"]?.Type != JTokenType.Integer)
+        {
+            throw new FormatException(LocalizationHelper.GetString("PersonalCultivation.InvalidLevelTarget"));
+        }
+
+        var elite = target.Value<int>("elite");
+        var level = target.Value<int>("level");
+        if (elite is < 0 or > 2 || level is < 1 or > 90)
+        {
+            throw new FormatException(LocalizationHelper.GetString("PersonalCultivation.InvalidLevelTarget"));
+        }
+
+        return new LevelTarget(elite, level);
+    }
+
+    private void HandleLevelProgress(AsstSubTaskMsg msg)
+    {
+        var details = msg.Details;
+        if (details is null)
+        {
+            return;
+        }
+
+        var result = details.Value<string>("result");
+        var reason = details.Value<string>("reason") ?? details.Value<string>("result_detail");
+        var confirmed = result is "Completed" or "AlreadySatisfied" ||
+            (result == "Success" && reason is "Completed" or "AlreadySatisfied");
+        var name = details.Value<string>("name") ?? string.Empty;
+        var elite = details.Value<int?>("elite");
+        var level = details.Value<int?>("level");
+        var task = GetConfigByTaskId<OperProgressTask>(msg.TaskId);
+        if (confirmed && elite is not null && level is not null && task is not null)
+        {
+            var role = ParsePlan(details).Role;
+            task.Plans = task.Plans.Select(plan => plan.Name == name && (role == OperatorRole.Unknown || plan.Role == role) &&
+                plan.TargetLevel is { } target && (elite > target.Elite || (elite == target.Elite && level >= target.Level))
+                    ? plan with { TargetLevel = null }
+                    : plan).ToList();
+            RefreshUI(TaskSettingVisibilityInfo.CurrentTask);
+        }
+
+        Instances.TaskQueueViewModel.AddLog(
+            LocalizationHelper.GetStringFormat(confirmed ? "PersonalCultivation.LevelProgress" : "PersonalCultivation.LevelPending",
+                DataHelper.GetLocalizedCharacterName(name) ?? name,
+                confirmed ? elite ?? -1 : details.Value<int?>("target_elite") ?? -1,
+                confirmed ? level ?? -1 : details.Value<int?>("target_level") ?? -1,
+                confirmed ? LocalizationHelper.GetString("Common.Success") : LocalizeSupplyReason(reason)),
+            confirmed ? UiLogColor.Info : UiLogColor.Warning);
+    }
+
+    private static void HandleSupplyProgress(AsstSubTaskMsg msg)
+    {
+        if (msg.Details is not { } details)
+        {
+            return;
+        }
+
+        var name = details.Value<string>("name") ?? string.Empty;
+        var itemId = details.Value<string>("item_id") ?? string.Empty;
+        var action = details.Value<string>("action") ?? details.Value<string>("phase") ?? string.Empty;
+        var reason = details.Value<string>("reason");
+        Instances.TaskQueueViewModel.AddLog(
+            LocalizationHelper.GetStringFormat("PersonalCultivation.SupplyProgress",
+                DataHelper.GetLocalizedCharacterName(name) ?? name,
+                LocalizeSupplyReason(action),
+                SupplyItemName(itemId),
+                details.Value<int?>("missing") ?? 0,
+                details.Value<string>("stage") ?? string.Empty,
+                LocalizeSupplyReason(reason)),
+            string.IsNullOrEmpty(reason) ? UiLogColor.Info : UiLogColor.Warning);
+    }
+
+    private static string LocalizeSupplyReason(string? value) => value switch {
+        null or "" => string.Empty,
+        "farm" or "farming" => LocalizationHelper.GetString("PersonalCultivation.ActionFarm"),
+        "synthesize" or "craft" => LocalizationHelper.GetString("PersonalCultivation.ActionCraft"),
+        "purchase" or "buy" or "credit" or "red_voucher" => LocalizationHelper.GetString("PersonalCultivation.ActionBuy"),
+        "inspect" => LocalizationHelper.GetString("PersonalCultivation.ActionInspect"),
+        "missing" => LocalizationHelper.GetString("PersonalCultivation.ActionMissing"),
+        "blocked" => LocalizationHelper.GetString("PersonalCultivation.ActionBlocked"),
+        "budget_exhausted" or "BudgetExhausted" or "RedVoucherBudgetReached" => LocalizationHelper.GetString("PersonalCultivation.BudgetExhausted"),
+        "no_progress" or "NoProgress" or "NoMaterialProgress" or "OperationLimit" => LocalizationHelper.GetString("PersonalCultivation.NoProgress"),
+        "RecognitionFailed" or "recognition_failed" or "InventoryRecognitionFailed" or "LevelSelectionUncertain" => LocalizationHelper.GetString("PersonalCultivation.RecognitionFailed"),
+        "stage_unavailable" or "StageUnavailable" or "MaterialSourceUnavailable" => LocalizationHelper.GetString("PersonalCultivation.StageUnavailable"),
+        "PrerequisiteTraining" or "TrainingRoomBusy" => LocalizationHelper.GetString("PersonalCultivation.TrainingPending"),
+        "CultivationDataMissing" or "InvalidRecipe" => LocalizationHelper.GetString("PersonalCultivation.DataUnavailable"),
+        "BudgetStateInvalid" => LocalizationHelper.GetString("PersonalCultivation.BudgetStateInvalid"),
+        "CreditBudgetReached" => LocalizationHelper.GetString("PersonalCultivation.CreditBudgetReached"),
+        "ExperienceProgressUncertain" => LocalizationHelper.GetString("PersonalCultivation.ExperienceProgressUncertain"),
+        "PurchaseAmountUncertain" or "PurchasePriceUncertain" => LocalizationHelper.GetString("PersonalCultivation.PurchaseUncertain"),
+        "Interrupted" or "Interrupt" => LocalizationHelper.GetString("PersonalCultivation.Interrupted"),
+        "RedVoucherPurchaseDisabled" => LocalizationHelper.GetString("PersonalCultivation.RedVoucherPurchaseDisabled"),
+        "ResourceInsufficient" => LocalizationHelper.GetString("PersonalCultivation.ResourceInsufficient"),
+        "Unsupported" or "PrerequisiteNotMet" => LocalizationHelper.GetString("PersonalCultivation.PrerequisiteNotMet"),
+        _ => LocalizationHelper.GetString("PersonalCultivation.ActionBlocked"),
+    };
+
+    private static string SupplyItemName(string itemId) => itemId == "__experience"
+        ? LocalizationHelper.GetString("PersonalCultivation.Experience")
+        : ItemListHelper.GetItemName(itemId) ?? itemId;
+}
