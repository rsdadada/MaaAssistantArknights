diff --git a/src/MaaWpfGui/Configuration/Single/MaaTask/OperProgressTask.cs b/src/MaaWpfGui/Configuration/Single/MaaTask/OperProgressTask.cs
index 49d8443bf7..ca395718c5 100644
--- a/src/MaaWpfGui/Configuration/Single/MaaTask/OperProgressTask.cs
+++ b/src/MaaWpfGui/Configuration/Single/MaaTask/OperProgressTask.cs
@@ -33,7 +33,45 @@ public class OperProgressTask : BaseTask
 
     public List<Plan> Plans { get; set; } = [];
 
-    public record Plan(OperatorRole Role, string Name, int Elite, int SkillLevel, SkillMastery SkillMastery, bool ShowRole);
+    public SupplyOptions Supply { get; set; } = new();
+
+    public record Plan(OperatorRole Role, string Name, int Elite, int SkillLevel, SkillMastery SkillMastery, bool ShowRole)
+    {
+        public LevelTarget? TargetLevel { get; init; }
+    }
+
+    public record LevelTarget(int Elite, int Level);
+
+    public record SupplyOptions
+    {
+        public bool Enabled { get; init; }
+
+        public PurchaseBudget Credit { get; init; } = new();
+
+        public PurchaseBudget RedVoucher { get; init; } = new();
+
+        public MedicineBudget Medicine { get; init; } = new();
+
+        public Dictionary<string, string> StageOverrides { get; init; } = [];
+    }
+
+    public record PurchaseBudget
+    {
+        public bool Enabled { get; init; }
+
+        public int DailyLimit { get; init; }
+
+        public int Reserve { get; init; }
+    }
+
+    public record MedicineBudget
+    {
+        public bool Enabled { get; init; }
+
+        public int DailyLimit { get; init; }
+
+        public bool UseExpiring { get; init; }
+    }
 
     /// <summary>
     /// 干员技能 1/2/3 的专精等级，未设定的技能为 0。
