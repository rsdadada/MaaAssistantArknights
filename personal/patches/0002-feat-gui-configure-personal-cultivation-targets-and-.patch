+
+using System.Text.Json;
+using MaaWpfGui.Configuration.Single;
+using MaaWpfGui.Configuration.Single.MaaTask;
+using MaaWpfGui.Constants.Enums;
+using MaaWpfGui.Models.AsstTasks;
+using Newtonsoft.Json.Linq;
+using static MaaWpfGui.Configuration.Single.MaaTask.OperProgressTask;
+
+int checks = 0;
+void Check(bool condition, string message)
+{
+    if (!condition)
+    {
+        throw new InvalidOperationException(message);
+    }
+
+    checks++;
+}
+
+var oldConfig = JsonSerializer.Deserialize<OperProgressTask>("""
+    {"Plans":[{"Name":"桃金娘","Elite":2,"SkillLevel":7,"SkillMastery":[1,0,0],"ShowRole":false}]}
+    """)!;
+Check(!oldConfig.Supply.Enabled, "Existing tasks must not enable auto-supply implicitly.");
+Check(oldConfig.Plans[0].TargetLevel is null, "Existing targets must not acquire a level target.");
+Check(!oldConfig.Supply.Credit.Enabled && !oldConfig.Supply.RedVoucher.Enabled && !oldConfig.Supply.Medicine.Enabled,
+    "Default settings must not spend currency or potions.");
+Check(oldConfig.Supply.Credit.DailyLimit == 0 && oldConfig.Supply.RedVoucher.DailyLimit == 0 && oldConfig.Supply.Medicine.DailyLimit == 0,
+    "New budgets must start at zero.");
+
+var plan = new Plan(OperatorRole.Warrior, "测试干员", 2, 7, SkillMastery.Of(0, 0, 3), false)
+{
+    TargetLevel = new LevelTarget(2, 60),
+};
+var promoted = plan with { Elite = 0 };
+var restored = JsonSerializer.Deserialize<Plan>(JsonSerializer.Serialize(promoted))!;
+Check(restored.TargetLevel == new LevelTarget(2, 60), "Clearing a completed promotion must retain the independent level target after restart.");
+Check(restored.SkillMastery[2] == 3, "Specialization must survive configuration serialization.");
+
+var disabled = new AsstOperProgressTask { Plans = [restored] }.Serialize().Params;
+Check(disabled["supply"] is null, "Disabled supply must preserve the original Core request shape.");
+Check(disabled["plans"]![0]!["elite"] is null, "A cleared promotion must not be resubmitted.");
+Check(disabled["plans"]![0]!["target_level"]!.Value<int>("elite") == 2 && disabled["plans"]![0]!["target_level"]!.Value<int>("level") == 60,
+    "Level target serialization must preserve phase and level separately.");
+
+const string profileId = "bb390fc930db4d9895fecbd16122fc21";
+var supply = new SupplyOptions
+{
+    Enabled = true,
+    Credit = new PurchaseBudget { Enabled = true, DailyLimit = 200, Reserve = 100 },
+    RedVoucher = new PurchaseBudget { Enabled = true, DailyLimit = 360, Reserve = 90 },
+    Medicine = new MedicineBudget { Enabled = true, DailyLimit = 2, UseExpiring = true },
+    StageOverrides = new Dictionary<string, string> { ["30012"] = "1-7" },
+};
+var enabled = new AsstOperProgressTask { Plans = [restored], Supply = supply, ProfileId = profileId }.Serialize().Params;
+var serializedSupply = enabled["supply"]!;
+Check(serializedSupply.Value<string>("profile_id") == profileId, "Core must receive the persisted profile budget identity.");
+Check(serializedSupply["credit"]!.Value<int>("daily_limit") == 200 && serializedSupply["credit"]!.Value<int>("reserve") == 100,
+    "Credit limits must not be lost or exchanged with reserve amounts.");
+Check(serializedSupply["red_voucher"]!.Value<int>("daily_limit") == 360 && serializedSupply["red_voucher"]!.Value<int>("reserve") == 90,
+    "Red voucher limits must be independent of credit limits.");
+Check(serializedSupply["medicine"]!.Value<int>("daily_limit") == 2 && serializedSupply["medicine"]!.Value<bool>("use_expiring"),
+    "Expiring potions must be accompanied by the common daily potion limit.");
+Check(serializedSupply["stage_overrides"]!.Value<string>("30012") == "1-7", "Typed material sources must serialize to the Core item-to-stage map.");
+Check(serializedSupply["stone"] is null && enabled["stone"] is null, "Cultivation must not enable Originite Prime spending.");
+
+var copiedTask = JsonSerializer.Deserialize<OperProgressTask>(JsonSerializer.Serialize(new OperProgressTask { Plans = [restored], Supply = supply }))!;
+Check(copiedTask.Supply.StageOverrides["30012"] == "1-7" && copiedTask.Supply.RedVoucher.Reserve == 90,
+    "Budgets and typed stage overrides must survive configuration persistence.");
+var profile = JsonSerializer.Deserialize<SpecificConfig>($"{{\"PersonalCultivationProfileId\":\"{profileId}\"}}")!;
+Check(profile.PersonalCultivationProfileId == profileId, "Restoring a profile must retain the budget identity rather than generate a new allowance.");
+
+Console.WriteLine($"{checks} cultivation UI contract checks passed.");
