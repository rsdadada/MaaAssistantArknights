diff --git a/src/MaaCore/Task/OperProgress/OperProgressLevelTask.cpp b/src/MaaCore/Task/OperProgress/OperProgressLevelTask.cpp
new file mode 100644
index 0000000000..c7e45ff44b
--- /dev/null
+++ b/src/MaaCore/Task/OperProgress/OperProgressLevelTask.cpp
@@ -0,0 +1,234 @@
+#include "OperProgressProcessTask.h"
+
+#include <algorithm>
+#include <regex>
+
+#include "Config/TaskData.h"
+#include "Controller/Controller.h"
+#include "Vision/FeatureMatcher.h"
+#include "Vision/Matcher.h"
+#include "Vision/OCRer.h"
+#include "Vision/Oper/OperFilesImageAnalyzer.h"
+
+std::optional<int> asst::OperProgressProcessTask::recognize_level(const cv::Mat& image, bool projected)
+{
+    OCRer analyzer(image);
+    if (!analyzer.analyze()) {
+        return std::nullopt;
+    }
+    static const std::regex combined(R"((?:LV|Lv|lv)[. :]*([0-9]{1,2})(?:$|[^0-9]))");
+    static const std::regex label(R"(^(?:LV|Lv|lv)[. :]*$)");
+    std::vector<int> candidates;
+    for (const auto& text : analyzer.get_result()) {
+        std::smatch match;
+        if (std::regex_search(text.text, match, combined)) {
+            if (const auto level = oper_progress::parse_material_number(match[1].str());
+                level && *level > 0 && *level <= 90) {
+                candidates.emplace_back(*level);
+            }
+        }
+        else if (std::regex_match(text.text, label)) {
+            for (const auto& number : analyzer.get_result()) {
+                const auto level = oper_progress::parse_material_number(number.text);
+                if (!level || *level < 1 || *level > 90) {
+                    continue;
+                }
+                const auto& left = text.rect;
+                const auto& right = number.rect;
+                if (right.x >= left.x + left.width && right.x <= left.x + left.width + 6 * left.height &&
+                    right.y < left.y + left.height && right.y + right.height > left.y) {
+                    candidates.emplace_back(*level);
+                }
+            }
+        }
+    }
+    if (candidates.empty() && !projected && m_supply) {
+        Matcher maximum(image);
+        maximum.set_task_info("OperProgress@LevelMax");
+        const auto elite = OperFilesImageAnalyzer(image).elite_level();
+        if (elite && maximum.analyze()) {
+            return m_supply->max_level(m_current_name, *elite);
+        }
+    }
+    if (candidates.empty() || candidates.size() > (projected ? 2U : 1U)) {
+        return std::nullopt;
+    }
+    // On the level-up page both the old and projected level can be visible. Level never decreases here.
+    return *std::ranges::max_element(candidates);
+}
+
+std::optional<int> asst::OperProgressProcessTask::recognize_level_experience(const cv::Mat& image, int expected_total)
+{
+    OCRer analyzer(image);
+    if (!analyzer.analyze()) {
+        return std::nullopt;
+    }
+    static const std::regex fraction(R"(([0-9]+)\s*/\s*([0-9]+))");
+    std::optional<int> earned;
+    for (const auto& text : analyzer.get_result()) {
+        std::smatch match;
+        if (!std::regex_search(text.text, match, fraction)) {
+            continue;
+        }
+        const auto numerator = oper_progress::parse_material_number(match[1].str());
+        const auto denominator = oper_progress::parse_material_number(match[2].str());
+        if (numerator && denominator && *denominator == expected_total && *numerator < *denominator) {
+            if (earned && *earned != *numerator) {
+                return std::nullopt;
+            }
+            earned = numerator;
+        }
+    }
+    return earned;
+}
+
+asst::OperProgressProcessTask::ResultDetail asst::OperProgressProcessTask::execute_level(
+    battle::Role role,
+    const std::string& name,
+    const OperProgressTask::LevelTarget& target)
+{
+    if (!m_supply) {
+        return ResultDetail::Unsupported;
+    }
+    if (find_and_open_operator(role, name) != ResultDetail::Completed) {
+        return ResultDetail::RecognitionFailed;
+    }
+    const auto elite = OperFilesImageAnalyzer(ctrler()->get_image()).elite_level();
+    if (!elite) {
+        return ResultDetail::RecognitionFailed;
+    }
+    if (*elite > target.elite) {
+        return ResultDetail::AlreadySatisfied;
+    }
+    if (*elite < target.elite) {
+        const auto promoted = execute_elite(role, name, target.elite);
+        if (promoted != ResultDetail::Completed && promoted != ResultDetail::AlreadySatisfied) {
+            return promoted;
+        }
+    }
+    const auto maximum = m_supply->max_level(name, target.elite);
+    if (!maximum || target.level > *maximum) {
+        return ResultDetail::Unsupported;
+    }
+    bool changed = false;
+    for (int steps = 0; steps < 180 && !need_exit(); ++steps) {
+        const auto snapshot = ctrler()->get_image();
+        const auto current = recognize_level(snapshot);
+        if (!current || *current > *maximum) {
+            return ResultDetail::RecognitionFailed;
+        }
+        if (!sleep(250) || current != recognize_level(ctrler()->get_image())) {
+            return ResultDetail::RecognitionFailed;
+        }
+        if (*current >= target.level) {
+            return changed ? ResultDetail::Completed : ResultDetail::AlreadySatisfied;
+        }
+        const auto full_experience = m_supply->level_experience(target.elite, *current);
+        auto earned = full_experience ? recognize_level_experience(snapshot, *full_experience) : std::nullopt;
+        if (earned && earned != recognize_level_experience(ctrler()->get_image(), *full_experience)) {
+            earned.reset();
+        }
+        // Count the experience already earned. Unknown progress may use existing records, but must not trigger farming.
+        if (earned && !m_supply->prepare_level(name, target.elite, *current, *current + 1, *earned)) {
+            return ResultDetail::ResourceInsufficient;
+        }
+        if (!m_supply->refresh_inventory()) {
+            return ResultDetail::ResourceInsufficient;
+        }
+        auto books = m_supply->experience_books();
+        if (books.empty()) {
+            if (!earned) {
+                m_supply->report("blocked", "__experience", 0, "ExperienceProgressUncertain");
+            }
+            return ResultDetail::ResourceInsufficient;
+        }
+        std::vector<std::pair<std::string, int>> ordered(books.begin(), books.end());
+        std::ranges::sort(ordered, std::greater {}, [](const auto& item) { return item.second; });
+        bool upgraded = false;
+        for (const auto& [book, _] : ordered) {
+            if (need_exit()) {
+                return ResultDetail::Interrupt;
+            }
+            if (find_and_open_operator(role, name) != ResultDetail::Completed ||
+                !run_task("PersonalCultivation@OpenLevelPage", 2)) {
+                return ResultDetail::RecognitionFailed;
+            }
+            for (int clicks = 0; clicks < 300 && !need_exit(); ++clicks) {
+                const auto image = ctrler()->get_image();
+                Matcher page(image);
+                page.set_task_info("PersonalCultivation@LevelPage");
+                if (!page.analyze()) {
+                    return ResultDetail::RecognitionFailed;
+                }
+                FeatureMatcher record(image);
+                record.set_templ(book);
+                record.set_count(20);
+                const auto positions = record.analyze();
+                if (!positions || positions->size() != 1 || !ctrler()->click(positions->front().rect) || !sleep(250)) {
+                    break;
+                }
+                const auto predicted = recognize_level(ctrler()->get_image(), true);
+                if (!predicted || *predicted < *current) {
+                    return ResultDetail::RecognitionFailed;
+                }
+                if (*predicted > target.level) {
+                    // Leave this unconfirmed selection and try a smaller record; do not exceed the user's target.
+                    break;
+                }
+                if (*predicted == *current) {
+                    continue;
+                }
+                if (!sleep(250) || predicted != recognize_level(ctrler()->get_image(), true) || need_exit() ||
+                    !run_task("PersonalCultivation@ConfirmLevel", 1)) {
+                    return ResultDetail::RecognitionFailed;
+                }
+                const auto actual_elite = OperFilesImageAnalyzer(ctrler()->get_image()).elite_level();
+                const auto actual_level = recognize_level(ctrler()->get_image());
+                if (!actual_elite || *actual_elite != target.elite || !actual_level || *actual_level != *predicted) {
+                    return ResultDetail::RecognitionFailed;
+                }
+                upgraded = true;
+                changed = true;
+                break;
+            }
+            if (upgraded) {
+                break;
+            }
+        }
+        if (!upgraded) {
+            m_supply->report("blocked", "__experience", 0, "LevelSelectionUncertain");
+            return ResultDetail::RecognitionFailed;
+        }
+    }
+    return need_exit() ? ResultDetail::Interrupt : ResultDetail::RecognitionFailed;
+}
+
+void asst::OperProgressProcessTask::report_level_result(
+    battle::Role role,
+    const std::string& name,
+    ResultDetail result,
+    const OperProgressTask::LevelTarget& target)
+{
+    const bool completed = result == ResultDetail::Completed || result == ResultDetail::AlreadySatisfied;
+    auto info = basic_info_with_what("OperProgressLevel");
+    info["details"] = json::object {
+        { "role", role },
+        { "name", name },
+        { "result", completed ? "Success" : "Failed" },
+        { "reason", result },
+        { "result_detail", result },
+        { "target_elite", target.elite },
+        { "target_level", target.level },
+    };
+    if (completed) {
+        info["details"]["elite"] = target.elite;
+        info["details"]["level"] = target.level;
+    }
+    callback(AsstMsg::SubTaskExtraInfo, info);
+    if (completed) {
+        ++m_success;
+    }
+    else {
+        ++m_failed;
+    }
+}
diff --git a/src/MaaCore/Task/OperProgress/OperProgressMaterials.h b/src/MaaCore/Task/OperProgress/OperProgressMaterials.h
new file mode 100644
index 0000000000..5b1d5967a8
--- /dev/null
+++ b/src/MaaCore/Task/OperProgress/OperProgressMaterials.h
@@ -0,0 +1,149 @@
+#pragma once
+
+#include <algorithm>
+#include <charconv>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace asst::oper_progress
+{
+struct FactoryProductionState
+{
+    std::string device;
+    std::string room;
+    std::string product;
+
+    bool matches(std::string_view current_device, std::string_view current_room) const
+    {
+        return !device.empty() && !room.empty() && device == current_device && room == current_room;
+    }
+};
+
+inline std::optional<std::string> parse_factory_room(std::string_view text)
+{
+    std::optional<std::string> room;
+    for (size_t i = 0; i + 4 <= text.size(); ++i) {
+        const auto candidate = text.substr(i, 4);
+        if (candidate[0] != 'B' || candidate[1] < '1' || candidate[1] > '3' || candidate[2] != '0' ||
+            candidate[3] < '1' || candidate[3] > '3') {
+            continue;
+        }
+        // 拒绝多房间号及尾随数字，不把截断或串入其他页面的文字当成制造站编号。
+        if (room || (i + 4 < text.size() && text[i + 4] >= '0' && text[i + 4] <= '9')) {
+            return std::nullopt;
+        }
+        room = std::string(candidate);
+    }
+    return room;
+}
+
+template <typename Produce, typename Restore, typename Cancelled>
+bool manufacture_with_restore(Produce produce, Restore restore, Cancelled cancelled)
+{
+    if (cancelled()) {
+        return false;
+    }
+    const bool produced = produce();
+    // 用户停止时不得继续点击；调用方保留恢复记录，在下一次培养开始前处理。
+    if (cancelled()) {
+        return false;
+    }
+    // 生产/确认/收取失败也必须恢复，不能被 produced 的短路求值跳过。
+    const bool restored = restore();
+    return produced && restored && !cancelled();
+}
+
+inline std::optional<int> parse_material_number(std::string_view text)
+{
+    const auto begin = text.find_first_not_of(" \t\r\n");
+    if (begin == std::string_view::npos) {
+        return std::nullopt;
+    }
+    text = text.substr(begin, text.find_last_not_of(" \t\r\n") - begin + 1);
+    int value = 0;
+    const auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+    if (error != std::errc {} || end != text.data() + text.size() || value < 0) {
+        return std::nullopt;
+    }
+    return value;
+}
+
+// A currency icon can be included in the OCR word as ASCII glyphs (for example EG90).
+// Only strip a short ASCII prefix; reject labels such as 已有4 and trailing digit corruption.
+inline std::optional<int> parse_currency_number(std::string_view text)
+{
+    const auto first = text.find_first_of("0123456789");
+    if (first == std::string_view::npos || first > 5 ||
+        !std::ranges::all_of(text.substr(0, first), [](unsigned char c) { return c < 128; })) {
+        return std::nullopt;
+    }
+    return parse_material_number(text.substr(first));
+}
+
+struct MaterialCount
+{
+    int owned = 0;
+    int required = 0;
+
+    int missing() const { return std::max(required - owned, 0); }
+};
+
+inline std::optional<MaterialCount> parse_material_count(std::string_view text)
+{
+    const auto slash = text.find('/');
+    if (slash == std::string_view::npos) {
+        return std::nullopt;
+    }
+    const auto owned = parse_material_number(text.substr(0, slash));
+    const auto required = parse_material_number(text.substr(slash + 1));
+    if (!owned || !required || *required == 0) {
+        return std::nullopt;
+    }
+    return MaterialCount { *owned, *required };
+}
+
+struct DualChipRequirements : MaterialCount
+{
+    int chip_packs() const { return missing() * 2; }
+
+    int catalysts() const { return missing(); }
+};
+
+inline std::optional<DualChipRequirements> parse_dual_chip_requirements(std::string_view text)
+{
+    const auto count = parse_material_count(text);
+    // 五星、六星精二分别需要三个、四个双芯片；拒绝截断或串入其他材料的 OCR。
+    if (!count || (count->required != 3 && count->required != 4)) {
+        return std::nullopt;
+    }
+    return DualChipRequirements { *count };
+}
+
+class ChipPackBatch
+{
+public:
+    ChipPackBatch(std::string_view target_item, int required) :
+        m_target_item(target_item),
+        m_required(required)
+    {
+    }
+
+    // StageDrops.stats 为当前 FightTask 的累计值；重复回调不能重复计数，其他职业掉落不抵扣缺口。
+    void observe(std::string_view item_id, int cumulative_quantity)
+    {
+        if (item_id == m_target_item && cumulative_quantity >= 0) {
+            m_obtained = std::max(m_obtained, std::min(cumulative_quantity, m_required));
+        }
+    }
+
+    int obtained() const { return m_obtained; }
+
+    int remaining() const { return m_required - m_obtained; }
+
+private:
+    std::string_view m_target_item;
+    int m_required = 0;
+    int m_obtained = 0;
+};
+}
