+#include "Task/OperProgress/OperProgressSupplyPlanning.h"
+
+namespace asst
+{
+class OperProgressProcessTask;
+
+class OperProgressSupplyCoordinator
+{
+public:
+    explicit OperProgressSupplyCoordinator(OperProgressProcessTask& owner, oper_progress::SupplyPolicy policy);
+
+    static bool load_data(const std::filesystem::path& path);
+    static std::optional<oper_progress::SupplyPolicy> parse_policy(const json::value& value);
+
+    bool begin();
+    bool prepare(const std::string& name, const oper_progress::MaterialAmounts& required);
+    bool refresh_inventory();
+    bool prepare_level(const std::string& name, int elite, int level, int target, int earned_experience);
+    std::optional<int> level_experience(int elite, int level) const;
+    std::optional<oper_progress::MaterialAmounts> elite_cost(const std::string& name, int target) const;
+    std::optional<oper_progress::MaterialAmounts> skill_cost(const std::string& name, int target) const;
+    std::optional<oper_progress::MaterialAmounts> mastery_cost(const std::string& name, int skill, int target) const;
+    std::optional<int> max_level(const std::string& name, int elite) const;
+    oper_progress::MaterialAmounts experience_books() const;
+
+    bool enabled() const { return m_policy.enabled; }
+
+    bool purchase_catalyst(int required);
+    void report(
+        std::string phase,
+        std::string item = {},
+        int missing = 0,
+        std::string reason = {},
+        std::string stage = {});
+
+private:
+    bool farm_one(const std::string& item, const std::string& stage);
+    bool purchase_credit(const std::string& item, int count);
+    bool load_budget();
+    bool save_budget();
+    bool reserve_budget(const std::string& currency, int cost, int balance);
+    void settle_budget(const std::string& currency, int reserved, int spent);
+    std::optional<oper_progress::MaterialAmounts> read_cost(const json::value& value) const;
+    std::optional<json::value> operator_data(const std::string& name) const;
+    int available(const std::string& item) const;
+
+    OperProgressProcessTask& m_owner;
+    oper_progress::SupplyPolicy m_policy;
+    oper_progress::DailySupplyBudget m_budget;
+    std::shared_ptr<const json::value> m_data;
+    oper_progress::MaterialAmounts m_inventory;
+    oper_progress::MaterialRecipes m_recipes;
+    std::map<std::string, std::string> m_sources;
+    std::set<std::string> m_failed_sources;
+    std::set<std::string> m_checked_credit;
+    std::filesystem::path m_budget_path;
+    std::string m_name;
+    bool m_budget_valid = false;
+};
+}
diff --git a/src/MaaCore/Task/OperProgress/OperProgressSupplyPlanning.h b/src/MaaCore/Task/OperProgress/OperProgressSupplyPlanning.h
new file mode 100644
index 0000000000..dfa6a34e5c
--- /dev/null
+++ b/src/MaaCore/Task/OperProgress/OperProgressSupplyPlanning.h
@@ -0,0 +1,147 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <string_view>
+
+namespace asst::oper_progress
+{
+using MaterialAmounts = std::map<std::string, int>;
+using MaterialRecipes = std::map<std::string, MaterialAmounts>;
+
+struct CurrencyPolicy
+{
+    bool enabled = false;
+    int daily_limit = 0;
+    int reserve = 0;
+};
+
+struct SupplyPolicy
+{
+    bool enabled = false;
+    std::string profile_id;
+    CurrencyPolicy credit;
+    CurrencyPolicy red_voucher;
+    CurrencyPolicy medicine;
+    bool use_expiring_medicine = false;
+    std::map<std::string, std::string> stage_overrides;
+};
+
+inline std::optional<std::pair<int, int>> remaining_level_cost(int full_experience, int earned, int full_gold)
+{
+    if (full_experience <= 0 || earned < 0 || earned >= full_experience || full_gold < 0) {
+        return std::nullopt;
+    }
+    const int remaining = full_experience - earned;
+    const auto gold = (static_cast<int64_t>(full_gold) * remaining + full_experience - 1) / full_experience;
+    return std::pair { remaining, static_cast<int>(gold) };
+}
+
+struct DailySupplyBudget
+{
+    int64_t day = -1;
+    int credit = 0;
+    int red_voucher = 0;
+    int medicine = 0;
+
+    // CN refreshes at 04:00 UTC+8. Use UTC arithmetic, independent of the host time zone.
+    static int64_t game_day(int64_t utc_seconds) { return (utc_seconds + 14'400) / 86'400; }
+
+    void advance_day(int64_t new_day)
+    {
+        // A backwards system clock must not reset a budget and permit another purchase.
+        if (new_day > day) {
+            *this = DailySupplyBudget { .day = new_day };
+        }
+    }
+
+    static bool can_spend(const CurrencyPolicy& policy, int spent, int balance, int cost)
+    {
+        return policy.enabled && spent >= 0 && cost > 0 && policy.daily_limit >= spent &&
+               cost <= policy.daily_limit - spent && balance >= policy.reserve && cost <= balance - policy.reserve;
+    }
+};
+
+// Consume a private inventory copy. Ingredients already allocated to another requirement cannot be reused.
+inline bool allocate_material(
+    const std::string& item,
+    int requested,
+    MaterialAmounts& inventory,
+    const MaterialRecipes& recipes,
+    const std::set<std::string>& farmable,
+    MaterialAmounts& missing,
+    std::set<std::string>& visiting)
+{
+    if (requested < 0 || visiting.size() >= 16 || visiting.contains(item)) {
+        return false;
+    }
+    const int used = std::min(std::max(inventory[item], 0), requested);
+    inventory[item] -= used;
+    requested -= used;
+    if (requested == 0) {
+        return true;
+    }
+    const auto recipe = recipes.find(item);
+    if (recipe != recipes.end() && !recipe->second.empty()) {
+        auto candidate_inventory = inventory;
+        MaterialAmounts ingredients_missing;
+        visiting.emplace(item);
+        bool valid = true;
+        for (const auto& [ingredient, quantity] : recipe->second) {
+            if (quantity <= 0 || requested > std::numeric_limits<int>::max() / quantity ||
+                !allocate_material(
+                    ingredient,
+                    requested * quantity,
+                    candidate_inventory,
+                    recipes,
+                    farmable,
+                    ingredients_missing,
+                    visiting)) {
+                valid = false;
+                break;
+            }
+        }
+        visiting.erase(item);
+        // Prefer a recipe when all ingredients are available. Otherwise farm the item directly when possible.
+        if (valid && (ingredients_missing.empty() || !farmable.contains(item))) {
+            inventory = std::move(candidate_inventory);
+            for (const auto& [ingredient, quantity] : ingredients_missing) {
+                if (missing[ingredient] > std::numeric_limits<int>::max() - quantity) {
+                    return false;
+                }
+                missing[ingredient] += quantity;
+            }
+            return true;
+        }
+        if (!valid && !farmable.contains(item)) {
+            return false;
+        }
+    }
+    if (missing[item] > std::numeric_limits<int>::max() - requested) {
+        return false;
+    }
+    missing[item] += requested;
+    return true;
+}
+
+inline std::optional<MaterialAmounts> plan_material_shortfall(
+    const MaterialAmounts& required,
+    MaterialAmounts inventory,
+    const MaterialRecipes& recipes,
+    const std::set<std::string>& farmable)
+{
+    MaterialAmounts missing;
+    std::set<std::string> visiting;
+    for (const auto& [item, quantity] : required) {
+        if (!allocate_material(item, quantity, inventory, recipes, farmable, missing, visiting)) {
+            return std::nullopt;
+        }
+    }
+    return missing;
+}
+}
