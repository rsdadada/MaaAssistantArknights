+
+void asst::CreditShoppingTask::set_demand_purchase(
+    std::string name,
+    std::function<bool(int, int)> reserve,
+    std::function<void(int, int)> settle)
+{
+    m_demand_name = std::move(name);
+    m_reserve_purchase = std::move(reserve);
+    m_settle_purchase = std::move(settle);
+    m_demand_completed = false;
+}
+
+bool asst::CreditShoppingTask::buy_demand_lot()
+{
+    if (need_exit() || m_demand_name.empty()) {
+        return false;
+    }
+    CreditShopImageAnalyzer analyzer(ctrler()->get_image());
+    analyzer.set_white_list({ m_demand_name });
+    if (!analyzer.analyze()) {
+        return true;
+    }
+    for (const auto& item : analyzer.get_result()) {
+        // The ordinary whitelist intentionally accepts substrings; demand mode requires the exact item name.
+        if (item.text != m_demand_name || !verify_commodity_name(item)) {
+            continue;
+        }
+        const auto read_price = [&]() -> std::optional<int> {
+            const auto image = ctrler()->get_image();
+            Matcher icon(image);
+            icon.set_task_info("CreditShop-Commodities");
+            icon.set_roi(item.rect);
+            const auto result = icon.analyze();
+            if (!result) {
+                return std::nullopt;
+            }
+            const auto& rect = result->rect;
+            // Existing CreditPoint anchor identifies the price row inside this exact commodity card.
+            Rect price_roi { rect.x + rect.width,
+                             rect.y,
+                             item.rect.x + item.rect.width - rect.x - rect.width,
+                             rect.height };
+            if (price_roi.width <= 0) {
+                return std::nullopt;
+            }
+            OCRer price(image);
+            price.set_task_info("NumberOcrReplace");
+            price.set_roi(price_roi);
+            if (!price.analyze() || price.get_result().size() != 1) {
+                return std::nullopt;
+            }
+            const auto amount = oper_progress::parse_material_number(price.get_result().front().text);
+            return amount && *amount > 0 ? amount : std::nullopt;
+        };
+        const auto price = read_price();
+        const int balance = credit_ocr();
+        if (!price || balance < 0 || !sleep(300) || price != read_price() || balance != credit_ocr() || need_exit() ||
+            !verify_commodity_name(item)) {
+            return false;
+        }
+        if (!m_reserve_purchase(*price, balance)) {
+            return true;
+        }
+        if (need_exit() || !ctrler()->click(item.rect) ||
+            !ProcessTask(*this, { "CreditShop-BuyIt" }).set_retry_times(0).run() || need_exit()) {
+            return false;
+        }
+        const int after = credit_ocr();
+        if (after < 0 || balance - after != *price) {
+            LogError << __FUNCTION__ << "credit purchase could not be reconciled";
+            return false;
+        }
+        m_settle_purchase(*price, balance - after);
+        m_demand_completed = true;
+        return true;
+    }
+    return true;
+}
