diff --git a/tools/PersonalCultivationTests/image_regression.py b/tools/PersonalCultivationTests/image_regression.py
new file mode 100644
index 0000000000..8e2c7e3e99
--- /dev/null
+++ b/tools/PersonalCultivationTests/image_regression.py
@@ -0,0 +1,128 @@
+"""Check bundled recognition fixtures with the exact Debug core/resource stack.
+
+The fixtures are existing development screenshots, visually checked to contain no
+player name or UID. They have no EXIF/text metadata (only ordinary JPEG JFIF/DPI).
+They preserve the original pixels and are never sent to a device. This test only
+uses Core's offline Debug task; it cannot execute a click or spend game resources.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--dll-dir", required=True, type=Path)
+    parser.add_argument(
+        "--source", type=Path, default=Path(__file__).resolve().parents[2]
+    )
+    parser.add_argument("--user-dir", required=True, type=Path)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    fixtures = source / "tools/PersonalCultivationTests/fixtures"
+    output = args.user_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    sys.path.insert(0, str(source / "tools"))
+    from maa_core_eval import CoreEval
+
+    # Algorithm assertions also catch an accidental JustReturn override that would
+    # otherwise make every positive recognition test pass without looking at pixels.
+    cases = {
+        "chip-recipes.jpg": [
+            *(
+                (f"OperProgress@MfgProduct-{role}", True, "MatchTemplate", None, 0.95)
+                for role in ("Pioneer", "Warrior", "Tank", "Sniper", "Caster", "Medic")
+            ),
+            ("OperProgress@MfgCollectChip", False, None, None, None),
+        ],
+        "catalyst-one.png": [
+            ("OperProgress@CatalystPurchaseCount", True, "OcrDetect", "1", 0.90),
+            ("OperProgress@MfgCollectChip", False, None, None, None),
+        ],
+        "manufacturing-preview.png": [
+            ("OperProgress@MfgCancelPreview", True, "MatchTemplate", None, 0.95),
+            ("OperProgress@MfgCancelFinalConfirm", False, None, None, None),
+        ],
+    }
+    reports = {}
+    failures = []
+    checked = 0
+    with os.add_dll_directory(str(args.dll_dir.resolve())):
+        core = CoreEval(
+            dll_dir=args.dll_dir.resolve(), resource=source, user_dir=output
+        )
+        try:
+            if not core._lib.AsstLoadResource(str(source / "personal").encode("utf-8")):
+                raise RuntimeError("Personal overlay did not load in Debug core")
+            for image, expectations in cases.items():
+                reports[image] = core.report(
+                    images=[fixtures / image], tasks=[case[0] for case in expectations]
+                )
+                results = reports[image]
+                if len(results) != 1 or len(results[0].get("results", [])) != len(
+                    expectations
+                ):
+                    raise RuntimeError(f"Incomplete Debug recognition report: {image}")
+                actual = {value["task"]: value for value in results[0]["results"]}
+                for task, hit, algorithm, text, score in expectations:
+                    result = actual.get(task, {})
+                    passed = (
+                        result.get("hit") is hit
+                        and (algorithm is None or result.get("algorithm") == algorithm)
+                        and (text is None or result.get("text") == text)
+                        and (score is None or result.get("score", 0) >= score)
+                    )
+                    checked += 1
+                    print(f"{'PASS' if passed else 'FAIL'} {image}: {task}", flush=True)
+                    if not passed:
+                        failures.append(
+                            {"image": image, "task": task, "actual": result}
+                        )
+
+            # Reproduce the runtime first-match priority: the open recipe preview
+            # must be cancelled before a manufacturing-page match can navigate on.
+            priority = core.pipeline(
+                images=[fixtures / "manufacturing-preview.png"],
+                tasks=[
+                    "OperProgress@MfgCancelFinalConfirm",
+                    "OperProgress@MfgCancelPreview",
+                    "OperProgress@MfgRestoreRecipeList",
+                    "OperProgress@MfgPage",
+                ],
+            )
+            reports["restoration_priority"] = priority
+            checked += 1
+            if (
+                len(priority) != 1
+                or not priority[0].get("hit")
+                or priority[0].get("result", {}).get("task")
+                != "OperProgress@MfgCancelPreview"
+            ):
+                failures.append({"case": "restoration_priority", "actual": priority})
+            else:
+                print("PASS manufacturing preview cancellation priority", flush=True)
+        finally:
+            core.close()
+
+    (output / "image-regression.json").write_text(
+        json.dumps(
+            {"checked": checked, "failures": failures, "reports": reports},
+            ensure_ascii=False,
+            indent=2,
+        ),
+        encoding="utf-8",
+    )
+    if failures:
+        raise RuntimeError(
+            f"{len(failures)} of {checked} Core image regression checks failed"
+        )
+    print(f"All {checked} Debug Core image regression checks passed")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/PersonalCultivationTests/run_tests.py b/tools/PersonalCultivationTests/run_tests.py
new file mode 100644
index 0000000000..83e1233d0d
--- /dev/null
+++ b/tools/PersonalCultivationTests/run_tests.py
@@ -0,0 +1,42 @@
+"""Build and run the actual C++ planning/budget implementation in Debug mode."""
+
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+
+def main() -> None:
+    source = Path(__file__).resolve().parent
+    root = source.parent.parent
+    cmake = os.environ.get("CMAKE_COMMAND") or shutil.which("cmake")
+    if not cmake:
+        cache = root / "build/core/CMakeCache.txt"
+        if cache.exists():
+            cmake = next(
+                (
+                    line.split("=", 1)[1]
+                    for line in cache.read_text().splitlines()
+                    if line.startswith("CMAKE_COMMAND:INTERNAL=")
+                ),
+                None,
+            )
+    if not cmake:
+        raise SystemExit("CMake is required; set CMAKE_COMMAND or put cmake on PATH.")
+    build = root / "build/personal-cultivation-tests"
+    subprocess.run([cmake, "-S", str(source), "-B", str(build)], check=True)
+    subprocess.run([cmake, "--build", str(build), "--config", "Debug"], check=True)
+    candidates = [
+        build / "Debug/personal_cultivation_tests.exe",
+        build / "personal_cultivation_tests",
+    ]
+    binary = next((path for path in candidates if path.exists()), None)
+    if binary is None:
+        raise SystemExit("Debug planning test binary was not produced.")
+    subprocess.run([str(binary)], check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/PersonalCultivationTests/supply_planning.cpp b/tools/PersonalCultivationTests/supply_planning.cpp
new file mode 100644
index 0000000000..4b165707b4
--- /dev/null
+++ b/tools/PersonalCultivationTests/supply_planning.cpp
@@ -0,0 +1,81 @@
+#include "Task/OperProgress/OperProgressMaterials.h"
+#include "Task/OperProgress/OperProgressSupplyPlanning.h"
+
+#include <cassert>
+#include <iostream>
+
+#ifdef NDEBUG
+#error Personal cultivation tests must run with assertions enabled.
+#endif
+
+int main()
+{
+    using namespace asst::oper_progress;
+    const MaterialRecipes recipes {
+        { "dual", { { "pack", 2 }, { "catalyst", 1 } } },
+        { "tier4", { { "tier3", 2 }, { "4001", 300 } } },
+        { "tier3", { { "tier2", 4 }, { "4001", 200 } } },
+    };
+    const std::set<std::string> sources { "pack", "catalyst", "tier3", "tier2", "4001" };
+    auto shortage = plan_material_shortfall({ { "dual", 4 } }, { { "dual", 1 }, { "pack", 4 } }, recipes, sources);
+    assert(shortage && shortage->at("pack") == 2 && shortage->at("catalyst") == 3);
+    assert(!shortage->contains("dual"));
+
+    // Complete targets do not create reserve replenishment demand.
+    shortage = plan_material_shortfall({}, { { "pack", 0 } }, recipes, sources);
+    assert(shortage && shortage->empty());
+
+    // Existing ingredients are synthesized before farming another directly farmable item.
+    shortage = plan_material_shortfall({ { "tier3", 1 } }, { { "tier2", 4 }, { "4001", 200 } }, recipes, sources);
+    assert(shortage && shortage->empty());
+    shortage = plan_material_shortfall({ { "tier3", 1 } }, { { "tier2", 1 } }, recipes, sources);
+    assert(shortage && shortage->size() == 1 && shortage->at("tier3") == 1);
+
+    // Both requirements share the same stock; neither a duplicate callback nor a recipe creates more stock.
+    shortage = plan_material_shortfall(
+        { { "tier3", 1 }, { "tier4", 1 } },
+        { { "tier3", 2 }, { "4001", 300 } },
+        recipes,
+        sources);
+    assert(shortage && shortage->at("tier3") == 1);
+    shortage = plan_material_shortfall({ { "dual", 4 } }, { { "pack", 8 }, { "catalyst", 4 } }, recipes, sources);
+    assert(shortage && shortage->empty());
+
+    // Invalid/cyclic resource data cannot recurse indefinitely or wrap material counts.
+    const MaterialRecipes cycle { { "a", { { "b", 1 } } }, { "b", { { "a", 1 } } } };
+    assert(!plan_material_shortfall({ { "a", 1 } }, {}, cycle, {}));
+    assert(!plan_material_shortfall({ { "dual", std::numeric_limits<int>::max() } }, {}, recipes, sources));
+
+    const auto level_cost = remaining_level_cost(1000, 800, 500);
+    assert(level_cost && level_cost->first == 200 && level_cost->second == 100);
+    shortage = plan_material_shortfall(
+        { { "__experience", level_cost->first }, { "4001", level_cost->second } },
+        { { "__experience", 200 }, { "4001", 100 } },
+        {},
+        { "__experience", "4001" });
+    assert(shortage && shortage->empty());
+    assert(!remaining_level_cost(1000, 1000, 500));
+    assert(!remaining_level_cost(1000, -1, 500));
+    assert(parse_currency_number("EG90") == 90);
+    assert(parse_currency_number(" 90") == 90);
+    assert(!parse_currency_number("已有4"));
+    assert(!parse_currency_number("90O"));
+
+    const CurrencyPolicy red { .enabled = true, .daily_limit = 180, .reserve = 90 };
+    assert(DailySupplyBudget::can_spend(red, 90, 180, 90));
+    assert(!DailySupplyBudget::can_spend(red, 180, 1000, 90));
+    assert(!DailySupplyBudget::can_spend(red, 0, 179, 90));
+    assert(!DailySupplyBudget::can_spend({}, 0, 1000, 90));
+    assert(!DailySupplyBudget::can_spend(red, 0, 1000, -1));
+
+    DailySupplyBudget state { .day = 20, .credit = 200, .red_voucher = 90, .medicine = 2 };
+    state.advance_day(20);
+    assert(state.credit == 200 && state.medicine == 2);
+    state.advance_day(19);
+    assert(state.day == 20 && state.red_voucher == 90);
+    state.advance_day(21);
+    assert(state.day == 21 && state.credit == 0 && state.red_voucher == 0 && state.medicine == 0);
+    assert(DailySupplyBudget::game_day(71'999) == 0);
+    assert(DailySupplyBudget::game_day(72'000) == 1);
+    std::cout << "Personal cultivation planner and budget tests passed\n";
+}
diff --git a/tools/PersonalRelease/generate_cultivation.py b/tools/PersonalRelease/generate_cultivation.py
new file mode 100644
index 0000000000..13c22225c1
--- /dev/null
+++ b/tools/PersonalRelease/generate_cultivation.py
@@ -0,0 +1,211 @@
+"""Generate the small, versioned cultivation database from MAA's game-data source."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+ROLES = {
+    "PIONEER": "Pioneer",
+    "WARRIOR": "Warrior",
+    "SNIPER": "Sniper",
+    "CASTER": "Caster",
+    "TANK": "Tank",
+    "MEDIC": "Medic",
+    "SUPPORT": "Support",
+    "SPECIAL": "Special",
+}
+
+# These are explicit permanent sources, not an efficiency optimiser. Every ordinary
+# material mapping is checked against the bundled NORMAL_DROP stage data below.
+SOURCES = {
+    "4001": "CE-6",
+    "4006": "AP-5",
+    "2001": "LS-6",
+    "2002": "LS-6",
+    "2003": "LS-6",
+    "2004": "LS-6",
+    "3301": "CA-5",
+    "3302": "CA-5",
+    "3303": "CA-5",
+    "30011": "0-9",
+    "30012": "1-7",
+    "30021": "0-7",
+    "30022": "2-2",
+    "30023": "4-2",
+    "30031": "0-11",
+    "30032": "1-8",
+    "30033": "3-8",
+    "30041": "1-3",
+    "30042": "2-1",
+    "30043": "5-5",
+    "30051": "1-6",
+    "30052": "3-7",
+    "30053": "4-5",
+    "30061": "1-5",
+    "30062": "1-12",
+    "30063": "4-10",
+    "30073": "4-4",
+    "30083": "4-7",
+    "30093": "4-8",
+    "30103": "4-9",
+    "31013": "7-8",
+    "31023": "6-12",
+    "31033": "R8-11",
+    "31043": "9-4",
+    "31053": "9-6",
+    "31063": "11-3",
+    "31073": "13-5",
+    "31083": "13-15",
+    "31093": "15-9",
+    "31103": "17-5",
+    "31113": "17-11",
+}
+for _item, _stage in {
+    "321": "C",
+    "322": "D",
+    "323": "A",
+    "324": "B",
+    "325": "B",
+    "326": "A",
+    "327": "C",
+    "328": "D",
+}.items():
+    for _tier in (1, 2):
+        SOURCES[f"{_item}{_tier}"] = f"PR-{_stage}-{_tier}"
+
+
+def read(path: Path):
+    return json.loads(path.read_text(encoding="utf-8-sig"))
+
+
+def cost(items) -> dict[str, int]:
+    result: dict[str, int] = {}
+    for item in items or []:
+        count = item["count"]
+        if not isinstance(count, int) or count < 0:
+            raise ValueError(f"Invalid material count: {item!r}")
+        if count:
+            result[item["id"]] = result.get(item["id"], 0) + count
+    return result
+
+
+def rarity_index(value) -> int:
+    return (
+        int(value.removeprefix("TIER_")) - 1 if isinstance(value, str) else int(value)
+    )
+
+
+def generate(data: Path, resources: Path, source_commit: str) -> dict:
+    characters = read(data / "character_table.json")
+    constants = read(data / "gamedata_const.json")
+    buildings = read(data / "building_data.json")
+    items = read(data / "item_table.json")
+    stages = read(resources / "stages.json")
+    item_index = read(resources / "item_index.json")
+    sources = dict(SOURCES)
+    normal_drops = {
+        (stage["code"], drop["itemId"])
+        for stage in stages
+        for drop in stage.get("dropInfos", [])
+        if drop.get("dropType") == "NORMAL_DROP" and drop.get("itemId")
+    }
+    for item, stage in sources.items():
+        if item.startswith(("300", "301", "310", "3110", "3111")):
+            if (stage, item) not in normal_drops:
+                raise ValueError(f"Unverified material source: {item} -> {stage}")
+
+    operators = {}
+    operators_by_id = {}
+    for char_id, char in sorted(characters.items()):
+        if not char_id.startswith("char_") or char.get("profession") not in ROLES:
+            continue
+        rarity = rarity_index(char["rarity"])
+        phases = []
+        for index, phase in enumerate(char["phases"]):
+            gold = 0 if index == 0 else constants["evolveGoldCost"][rarity][index - 1]
+            if gold < 0:
+                raise ValueError(f"Missing promotion price: {char_id}, phase {index}")
+            phases.append(
+                {
+                    "max_level": phase["maxLevel"],
+                    "evolve_cost": cost(phase.get("evolveCost")),
+                    "gold_cost": gold,
+                }
+            )
+        role = ROLES[char["profession"]]
+        operator = {
+            "id": char_id,
+            "name": char["name"],
+            "rarity": rarity + 1,
+            "role": role,
+            "phases": phases,
+            "skill_levels": [
+                cost(x.get("lvlUpCost")) for x in char.get("allSkillLvlup", [])
+            ],
+            "mastery": [
+                [cost(x.get("levelUpCost")) for x in skill.get("levelUpCostCond", [])]
+                for skill in char.get("skills", [])
+            ],
+        }
+        operators_by_id[char_id] = operator
+        operators.setdefault(char["name"], operator)
+
+    formulas = {}
+    formula_gold = {}
+    for formula in buildings["workshopFormulas"].values():
+        item = formula["itemId"]
+        # Chip conversion produces two chips from three of the other profession.
+        # Exclude it instead of creating cyclic/incorrect one-output recipes.
+        if formula["count"] != 1 or item not in item_index:
+            continue
+        if formula.get("formulaType") not in ("F_EVOLVE", "F_SKILL"):
+            continue
+        formulas[item] = cost(formula["costs"])
+        formula_gold[item] = formula.get("goldCost", 0)
+    for item, info in item_index.items():
+        if item.startswith("32") and item.endswith("3") and info.get("formula"):
+            formulas[item] = info["formula"]
+            formula_gold[item] = 0
+
+    experience = [[x for x in row if x >= 0] for row in constants["characterExpMap"]]
+    gold = [[x for x in row if x >= 0] for row in constants["characterUpgradeCostMap"]]
+    if len(experience) != 3 or any(len(a) != len(b) for a, b in zip(experience, gold)):
+        raise ValueError("Unexpected leveling data shape")
+    return {
+        "schema_version": 1,
+        "source_commit": source_commit,
+        "operators": operators,
+        "operators_by_id": operators_by_id,
+        "leveling": {"experience": experience, "gold": gold},
+        "experience_items": {
+            key: value["gainExp"] for key, value in items["expItems"].items()
+        },
+        "sources": sources,
+        "formulas": formulas,
+        "formula_gold": formula_gold,
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--data", required=True, type=Path)
+    parser.add_argument("--resources", default="resource", type=Path)
+    parser.add_argument("--source-commit", required=True)
+    parser.add_argument(
+        "--output", default="personal/resource/cultivation.json", type=Path
+    )
+    args = parser.parse_args()
+    result = generate(args.data, args.resources, args.source_commit)
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(
+        json.dumps(result, ensure_ascii=False, indent=4) + "\n", encoding="utf-8"
+    )
+    print(
+        f"Generated {len(result['operators'])} operators and {len(result['formulas'])} recipes"
+    )
+
+
+if __name__ == "__main__":
+    main()
