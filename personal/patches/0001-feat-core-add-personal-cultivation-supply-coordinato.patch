+bool asst::OperProgressSupplyCoordinator::load_data(const std::filesystem::path& path)
+{
+    const auto value = json::open(path);
+    if (!value || !value->is_object() || value->get("schema_version", 0) != 1) {
+        LogError << __FUNCTION__ << "invalid cultivation data header" << path;
+        return false;
+    }
+    for (const auto* key : { "operators", "leveling", "sources", "formulas", "experience_items" }) {
+        if (!value->contains(key) || !value->at(key).is_object()) {
+            LogError << __FUNCTION__ << "missing cultivation data section" << key;
+            return false;
+        }
+    }
+    for (const auto& [_, entry] : value->at("operators").as_object()) {
+        if (!entry.is_object() || !entry.contains("phases") || !entry.at("phases").is_array() ||
+            !entry.contains("skill_levels") || !entry.at("skill_levels").is_array() || !entry.contains("mastery") ||
+            !entry.at("mastery").is_array()) {
+            return false;
+        }
+        for (const auto& phase : entry.at("phases").as_array()) {
+            if (!phase.is_object() || !phase.find<int>("max_level") || !phase.find<int>("gold_cost") ||
+                !phase.contains("evolve_cost") || !oper_progress::valid_amounts(phase.at("evolve_cost"))) {
+                return false;
+            }
+        }
+        for (const auto& cost : entry.at("skill_levels").as_array()) {
+            if (!oper_progress::valid_amounts(cost)) {
+                return false;
+            }
+        }
+        for (const auto& skill : entry.at("mastery").as_array()) {
+            if (!skill.is_array() || !std::ranges::all_of(skill.as_array(), oper_progress::valid_amounts)) {
+                return false;
+            }
+        }
+    }
+    for (const auto& [_, recipe] : value->at("formulas").as_object()) {
+        if (!oper_progress::valid_amounts(recipe)) {
+            return false;
+        }
+    }
+    for (const auto& [_, stage] : value->at("sources").as_object()) {
+        if (!stage.is_string() || stage.as_string().empty()) {
+            return false;
+        }
+    }
+    for (const auto* key : { "experience", "gold" }) {
+        const auto& levels = value->at("leveling");
+        if (!levels.contains(key) || !levels.at(key).is_array()) {
+            return false;
+        }
+        for (const auto& row : levels.at(key).as_array()) {
+            if (!row.is_array() || !std::ranges::all_of(row.as_array(), [](const json::value& amount) {
+                    return amount.is<int>() && amount.as_integer() >= 0 && amount.as_integer() <= 10'000'000;
+                })) {
+                return false;
+            }
+        }
+    }
+    if (!oper_progress::valid_amounts(value->at("experience_items"))) {
+        return false;
+    }
+    const std::lock_guard lock(oper_progress::SupplyDataMutex);
+    oper_progress::SupplyData = std::make_shared<const json::value>(*value);
+    return true;
+}
+
+std::optional<asst::oper_progress::SupplyPolicy>
+    asst::OperProgressSupplyCoordinator::parse_policy(const json::value& value)
+{
+    if (!value.is_object()) {
+        return std::nullopt;
+    }
+    oper_progress::SupplyPolicy policy;
+    if (const auto enabled = value.find_value("enabled")) {
+        if (!enabled->is<bool>()) {
+            return std::nullopt;
+        }
+        policy.enabled = enabled->as_boolean();
+    }
+    if (const auto profile = value.find_value("profile_id")) {
+        if (!profile->is_string()) {
+            return std::nullopt;
+        }
+        policy.profile_id = profile->as_string();
+    }
+    if (policy.enabled && (policy.profile_id.empty() || policy.profile_id.size() > 100 ||
+                           !std::ranges::all_of(policy.profile_id, [](unsigned char c) {
+                               return std::isalnum(c) || c == '-' || c == '_';
+                           }))) {
+        return std::nullopt;
+    }
+    for (const auto& [key, destination] : { std::pair { "credit", &policy.credit },
+                                            std::pair { "red_voucher", &policy.red_voucher },
+                                            std::pair { "medicine", &policy.medicine } }) {
+        if (const auto currency = value.find_value(key)) {
+            if (!currency->is_object()) {
+                return std::nullopt;
+            }
+            if (const auto enabled = currency->find_value("enabled")) {
+                if (!enabled->is<bool>()) {
+                    return std::nullopt;
+                }
+                destination->enabled = enabled->as_boolean();
+            }
+            for (const auto& [field, target] : { std::pair { "daily_limit", &destination->daily_limit },
+                                                 std::pair { "reserve", &destination->reserve } }) {
+                if (const auto amount = currency->find_value(field)) {
+                    if (!amount->is<int>() || amount->as_integer() < 0 || amount->as_integer() > 10'000'000) {
+                        return std::nullopt;
+                    }
+                    *target = amount->as_integer();
+                }
+            }
+            if (std::string_view(key) == "medicine") {
+                if (const auto expiring = currency->find_value("use_expiring")) {
+                    if (!expiring->is<bool>()) {
+                        return std::nullopt;
+                    }
+                    policy.use_expiring_medicine = expiring->as_boolean();
+                }
+            }
+        }
+    }
+    if (const auto stages = value.find_value("stage_overrides")) {
+        if (!stages->is_object()) {
+            return std::nullopt;
+        }
+        for (const auto& [item, stage] : stages->as_object()) {
+            if (item.empty() || !stage.is_string() || stage.as_string().empty()) {
+                return std::nullopt;
+            }
+            policy.stage_overrides[item] = stage.as_string();
+        }
+    }
+    return policy;
+}
+
+asst::OperProgressSupplyCoordinator::OperProgressSupplyCoordinator(
+    OperProgressProcessTask& owner,
+    oper_progress::SupplyPolicy policy) :
+    m_owner(owner),
+    m_policy(std::move(policy))
+{
+    const std::lock_guard lock(oper_progress::SupplyDataMutex);
+    m_data = oper_progress::SupplyData;
+}
+
+bool asst::OperProgressSupplyCoordinator::begin()
+{
+    if (!m_data) {
+        report("blocked", {}, 0, "CultivationDataMissing");
+        return false;
+    }
+    for (const auto& [item, recipe] : m_data->at("formulas").as_object()) {
+        m_recipes[item] = *read_cost(recipe);
+        if (const auto gold = m_data->find_value("formula_gold")) {
+            const int amount = gold->get(item, 0);
+            if (amount > 0) {
+                m_recipes[item]["4001"] += amount;
+            }
+        }
+    }
+    for (const auto& [item, stage] : m_data->at("sources").as_object()) {
+        m_sources[item] = stage.as_string();
+    }
+    m_sources.insert_or_assign("__experience", "LS-6");
+    for (const auto& [item, stage] : m_policy.stage_overrides) {
+        m_sources[item] = stage;
+    }
+    if (!m_policy.enabled) {
+        return true;
+    }
+    m_budget_path =
+        UserDir.get() / utils::path("data/personal-cultivation") / utils::path(m_policy.profile_id + ".jsonl");
+    m_budget_valid = load_budget();
+    if (!m_budget_valid) {
+        report("blocked", {}, 0, "BudgetStateInvalid");
+        return false;
+    }
+    return true;
+}
+
+bool asst::OperProgressSupplyCoordinator::load_budget()
+{
+    std::error_code error;
+    const bool exists = std::filesystem::exists(m_budget_path, error);
+    if (error) {
+        return false;
+    }
+    if (exists) {
+        std::ifstream stream(m_budget_path);
+        if (!stream) {
+            return false;
+        }
+        std::string line;
+        while (std::getline(stream, line)) {
+            const auto value = json::parse(line);
+            if (!value || !value->is_object()) {
+                return false;
+            }
+            const auto day = value->find<int64_t>("day");
+            const auto credit = value->find<int>("credit");
+            const auto red = value->find<int>("red_voucher");
+            const auto medicine = value->find<int>("medicine");
+            if (!day || !credit || !red || !medicine || *day < m_budget.day || *credit < 0 || *red < 0 ||
+                *medicine < 0) {
+                return false;
+            }
+            m_budget = { *day, *credit, *red, *medicine };
+        }
+        if (!stream.eof()) {
+            return false;
+        }
+    }
+    m_budget.advance_day(oper_progress::current_game_day());
+    return true;
+}
+
+bool asst::OperProgressSupplyCoordinator::save_budget()
+{
+    std::error_code error;
+    std::filesystem::create_directories(m_budget_path.parent_path(), error);
+    if (error) {
+        m_budget_valid = false;
+        return false;
+    }
+    // Persist a reservation before the click. A truncated final record blocks spending on the next run.
+    std::ofstream stream(m_budget_path, std::ios::app | std::ios::binary);
+    const json::value value = json::object {
+        { "day", m_budget.day },
+        { "credit", m_budget.credit },
+        { "red_voucher", m_budget.red_voucher },
+        { "medicine", m_budget.medicine },
+    };
+    stream << value.to_string() << '\n';
+    stream.flush();
+    m_budget_valid = stream.good();
+    return m_budget_valid;
+}
+
+bool asst::OperProgressSupplyCoordinator::reserve_budget(const std::string& currency, int cost, int balance)
+{
+    if (!m_budget_valid) {
+        return false;
+    }
+    m_budget.advance_day(oper_progress::current_game_day());
+    const auto& policy = currency == "credit"        ? m_policy.credit
+                         : currency == "red_voucher" ? m_policy.red_voucher
+                                                     : m_policy.medicine;
+    int& spent = currency == "credit"        ? m_budget.credit
+                 : currency == "red_voucher" ? m_budget.red_voucher
+                                             : m_budget.medicine;
+    if (!oper_progress::DailySupplyBudget::can_spend(policy, spent, balance, cost)) {
+        return false;
+    }
+    spent += cost;
+    return save_budget();
+}
+
+void asst::OperProgressSupplyCoordinator::settle_budget(const std::string& currency, int reserved, int spent)
+{
+    if (spent < 0 || spent > reserved) {
+        m_budget_valid = false;
+        report("blocked", {}, 0, "PurchaseAmountUncertain");
+        return;
+    }
+    int& total = currency == "credit"        ? m_budget.credit
+                 : currency == "red_voucher" ? m_budget.red_voucher
+                                             : m_budget.medicine;
+    total -= reserved - spent;
+    save_budget();
+}
+
+std::optional<asst::oper_progress::MaterialAmounts>
+    asst::OperProgressSupplyCoordinator::read_cost(const json::value& value) const
+{
+    if (!oper_progress::valid_amounts(value)) {
+        return std::nullopt;
+    }
+    oper_progress::MaterialAmounts cost;
+    for (const auto& [item, amount] : value.as_object()) {
+        if (amount.as_integer() > 0) {
+            cost[item] = amount.as_integer();
+        }
+    }
+    return cost;
+}
+
+std::optional<asst::oper_progress::MaterialAmounts>
+    asst::OperProgressSupplyCoordinator::elite_cost(const std::string& name, int target) const
+{
+    const auto found = operator_data(name);
+    if (!found || target < 0 || target >= static_cast<int>(found->at("phases").as_array().size())) {
+        return std::nullopt;
+    }
+    const auto& phase = found->at("phases").at(target);
+    auto cost = read_cost(phase.at("evolve_cost"));
+    if (cost) {
+        (*cost)["4001"] += phase.get("gold_cost", 0);
+    }
+    return cost;
+}
+
+std::optional<asst::oper_progress::MaterialAmounts>
+    asst::OperProgressSupplyCoordinator::skill_cost(const std::string& name, int target) const
+{
+    const auto found = operator_data(name);
+    if (!found || target < 2 || target - 2 >= static_cast<int>(found->at("skill_levels").as_array().size())) {
+        return std::nullopt;
+    }
+    return read_cost(found->at("skill_levels").at(target - 2));
+}
+
+std::optional<asst::oper_progress::MaterialAmounts>
+    asst::OperProgressSupplyCoordinator::mastery_cost(const std::string& name, int skill, int target) const
+{
+    const auto found = operator_data(name);
+    if (!found || skill < 1 || skill > static_cast<int>(found->at("mastery").as_array().size())) {
+        return std::nullopt;
+    }
+    const auto& levels = found->at("mastery").at(skill - 1);
+    if (target < 1 || target > static_cast<int>(levels.as_array().size())) {
+        return std::nullopt;
+    }
+    return read_cost(levels.at(target - 1));
+}
+
+std::optional<int> asst::OperProgressSupplyCoordinator::max_level(const std::string& name, int elite) const
+{
+    const auto found = operator_data(name);
+    if (!found || elite < 0 || elite >= static_cast<int>(found->at("phases").as_array().size())) {
+        return std::nullopt;
+    }
+    return found->at("phases").at(elite).find<int>("max_level");
+}
+
+bool asst::OperProgressSupplyCoordinator::refresh_inventory()
+{
+    if (m_owner.need_exit()) {
+        return false;
+    }
+    bool complete = false;
+    oper_progress::MaterialAmounts recognized;
+    const AsstCallback callback = [&](AsstMsg message, const json::value& detail, Assistant*) {
+        if (message == AsstMsg::SubTaskExtraInfo && detail.get("what", "") == "DepotInfo" &&
+            detail.get("details", "done", false)) {
+            const auto items = json::parse(detail.get("details", "data", ""));
+            if (items && oper_progress::valid_amounts(*items)) {
+                recognized = *read_cost(*items);
+                complete = true;
+            }
+        }
+        auto forwarded = detail;
+        forwarded["taskchain"] = m_owner.m_task_chain;
+        m_owner.callback(message, forwarded);
+    };
+    DepotTask depot(callback, m_owner.m_inst);
+    depot.set_task_id(m_owner.m_task_id).set_retry_times(0);
+    if (!depot.run() || !complete || m_owner.need_exit()) {
+        report("blocked", {}, 0, "InventoryRecognitionFailed");
+        return false;
+    }
+    m_inventory = std::move(recognized);
+    int64_t experience = 0;
+    for (const auto& [item, amount] : m_data->at("experience_items").as_object()) {
+        experience += static_cast<int64_t>(available(item)) * amount.as_integer();
+    }
+    m_inventory["__experience"] = static_cast<int>(std::min<int64_t>(experience, 10'000'000));
+    return true;
+}
+
+int asst::OperProgressSupplyCoordinator::available(const std::string& item) const
+{
+    const auto found = m_inventory.find(item);
+    return found == m_inventory.end() ? 0 : found->second;
+}
+
+std::optional<int> asst::OperProgressSupplyCoordinator::level_experience(int elite, int level) const
+{
+    const auto& rows = m_data->at("leveling").at("experience").as_array();
+    if (elite < 0 || elite >= static_cast<int>(rows.size()) || level < 1 ||
+        level > static_cast<int>(rows.at(elite).as_array().size())) {
+        return std::nullopt;
+    }
+    return rows.at(elite).at(level - 1).as_integer();
+}
+
+bool asst::OperProgressSupplyCoordinator::prepare_level(
+    const std::string& name,
+    int elite,
+    int level,
+    int target,
+    int earned_experience)
+{
+    if (elite < 0 || elite > 2 || level < 1 || target < level) {
+        return false;
+    }
+    const auto& xp = m_data->at("leveling").at("experience").at(elite);
+    const auto& gold = m_data->at("leveling").at("gold").at(elite);
+    if (target - 1 > static_cast<int>(xp.as_array().size()) || target - 1 > static_cast<int>(gold.as_array().size())) {
+        return false;
+    }
+    int exp_required = 0;
+    int gold_required = 0;
+    for (int current = level; current < target; ++current) {
+        const auto remaining = oper_progress::remaining_level_cost(
+            xp.at(current - 1).as_integer(),
+            current == level ? earned_experience : 0,
+            gold.at(current - 1).as_integer());
+        if (!remaining) {
+            return false;
+        }
+        exp_required += remaining->first;
+        gold_required += remaining->second;
+    }
+    return prepare(name, { { "__experience", exp_required }, { "4001", gold_required } });
+}
+
+bool asst::OperProgressSupplyCoordinator::prepare(
+    const std::string& name,
+    const oper_progress::MaterialAmounts& required)
+{
+    m_name = name;
+    if (!m_policy.enabled) {
+        return true;
+    }
+    if (!refresh_inventory()) {
+        return false;
+    }
+    std::set<std::string> farmable;
+    for (const auto& [item, _] : m_sources) {
+        farmable.emplace(item);
+    }
+    farmable.emplace("32001");
+    int stagnant = 0;
+    for (int operations = 0; operations < 256 && !m_owner.need_exit(); ++operations) {
+        const auto missing = oper_progress::plan_material_shortfall(required, m_inventory, m_recipes, farmable);
+        if (!missing) {
+            report("blocked", {}, 0, "InvalidRecipe");
+            return false;
+        }
+        if (missing->empty()) {
+            return true;
+        }
+        const auto& [item, quantity] = *missing->begin();
+        report("missing", item, quantity);
+        bool progressed = false;
+        const int before = available(item);
+        if (item == "32001") {
+            progressed = purchase_catalyst(quantity);
+        }
+        else {
+            if (m_policy.credit.enabled && !m_checked_credit.contains(item)) {
+                m_checked_credit.emplace(item);
+                progressed = purchase_credit(item, quantity);
+            }
+            if (!progressed) {
+                const auto source = m_sources.find(item);
+                if (source == m_sources.end() || m_failed_sources.contains(source->second)) {
+                    report("blocked", item, quantity, "MaterialSourceUnavailable");
+                    return false;
+                }
+                progressed = farm_one(item, source->second);
+                if (!progressed) {
+                    m_failed_sources.emplace(source->second);
+                }
+            }
+        }
+        if (!progressed || !refresh_inventory()) {
+            return false;
+        }
+        stagnant = available(item) > before ? 0 : stagnant + 1;
+        if (stagnant >= 12) {
+            report("blocked", item, quantity, "NoMaterialProgress");
+            return false;
+        }
+    }
+    report("blocked", {}, 0, m_owner.need_exit() ? "Interrupted" : "OperationLimit");
+    return false;
+}
+
+bool asst::OperProgressSupplyCoordinator::farm_one(const std::string& item, const std::string& stage)
+{
+    if (m_owner.need_exit()) {
+        return false;
+    }
+    report("farming", item, 0, {}, stage);
+    const int allowance = reserve_budget("medicine", 1, 1) ? 1 : 0;
+    int used_medicine = 0;
+    bool drops_recognized = false;
+    bool invalid = false;
+    const AsstCallback callback = [&](AsstMsg message, const json::value& detail, Assistant*) {
+        if (message == AsstMsg::SubTaskExtraInfo) {
+            const auto what = detail.get("what", "");
+            if (what == "StageDrops") {
+                drops_recognized =
+                    detail.get("details", "stage", "stageCode", "") == stage && detail.get("details", "stars", 0) == 3;
+                invalid |= !drops_recognized;
+            }
+            else if (what == "UseMedicine") {
+                used_medicine += detail.get("details", "count", 0);
+            }
+        }
+        if (message == AsstMsg::SubTaskError && detail.get("subtask", "") == "RecognizeDrops") {
+            invalid = true;
+        }
+        auto forwarded = detail;
+        forwarded["taskchain"] = m_owner.m_task_chain;
+        m_owner.callback(message, forwarded);
+    };
+    FightTask fight(callback, m_owner.m_inst);
+    fight.set_task_id(m_owner.m_task_id).set_retry_times(0);
+    const json::value params = json::object {
+        { "stage", stage },
+        { "times", 1 },
+        { "series", 1 },
+        { "stone", 0 },
+        { "medicine", m_policy.use_expiring_medicine ? 0 : allowance },
+        { "medicine_total_limit", allowance },
+        { "medicine_expire_days", allowance > 0 && m_policy.use_expiring_medicine ? 2 : 0 },
+        { "client_type", "Official" },
+        { "server", "CN" },
+    };
+    const bool succeeded = fight.set_params(params) && fight.run();
+    if (succeeded && !invalid && !m_owner.need_exit()) {
+        settle_budget("medicine", allowance, used_medicine);
+    }
+    // On an uncertain failure keep the reservation, rather than risk spending again after restart.
+    return succeeded && drops_recognized && !invalid && !m_owner.need_exit();
+}
+
+bool asst::OperProgressSupplyCoordinator::purchase_credit(const std::string& item, int count)
+{
+    if (count <= 0 || m_owner.need_exit() || ItemData.get_item_name(item).empty() ||
+        !m_owner.run_task("MallBegin", 2)) {
+        return false;
+    }
+    report("credit", item, count);
+    CreditShoppingTask shop(m_owner.m_callback, m_owner.m_inst, m_owner.m_task_chain);
+    shop.set_task_id(m_owner.m_task_id).set_retry_times(0);
+    shop.set_demand_purchase(
+        ItemData.get_item_name(item),
+        [&](int price, int balance) {
+            const bool reserved = reserve_budget("credit", price, balance);
+            if (!reserved) {
+                report("blocked", item, count, "CreditBudgetReached");
+            }
+            return reserved;
+        },
+        [&](int reserved, int actual) { settle_budget("credit", reserved, actual); });
+    const bool succeeded = shop.run();
+    if (!succeeded) {
+        // An interrupted purchase is reconciled by the next inventory scan; do not spend more this run.
+        m_budget_valid = false;
+    }
+    return succeeded && shop.demand_purchase_completed() && !m_owner.need_exit();
+}
+
+bool asst::OperProgressSupplyCoordinator::purchase_catalyst(int required)
+{
+    if (!m_policy.red_voucher.enabled || required <= 0 || m_owner.need_exit()) {
+        report("blocked", "32001", required, "RedVoucherPurchaseDisabled");
+        return false;
+    }
+    if (!m_owner.run_task("Store@QuickSwitchEnterStore", 2) ||
+        !m_owner.run_task("RedTicket@Store@ChooseTicketType", 2)) {
+        return false;
+    }
+    bool found = false;
+    for (int page = 0; page < 5 && !m_owner.need_exit(); ++page) {
+        if (m_owner.run_task("RedTicket@Store@ClickItem_Catalyst", 0)) {
+            found = true;
+            break;
+        }
+        if (!m_owner.run_task("RedTicket@Store@Swipe", 0)) {
+            break;
+        }
+    }
+    if (!found) {
+        return false;
+    }
+    const auto read_price = [&]() -> std::optional<int> {
+        if (m_owner.ocr_number("OperProgress@CatalystPurchaseCount") != 1) {
+            return std::nullopt;
+        }
+        OCRer text(m_owner.ctrler()->get_image());
+        if (!text.analyze()) {
+            return std::nullopt;
+        }
+        const auto labeled_number = [&](std::string_view label) -> std::optional<int> {
+            std::optional<int> number;
+            for (const auto& result : text.get_result()) {
+                const auto position = result.text.find(label);
+                if (position == std::string::npos) {
+                    continue;
+                }
+                const auto suffix = std::string_view(result.text).substr(position + label.size());
+                const auto digits = suffix.find_first_of("0123456789");
+                if (digits != std::string_view::npos) {
+                    const auto parsed = oper_progress::parse_material_number(suffix.substr(digits));
+                    if (!parsed || number) {
+                        return std::nullopt;
+                    }
+                    number = parsed;
+                    continue;
+                }
+                for (const auto& candidate : text.get_result()) {
+                    const auto parsed = oper_progress::parse_currency_number(candidate.text);
+                    if (!parsed || candidate.rect.x < result.rect.x + result.rect.width ||
+                        candidate.rect.x > result.rect.x + result.rect.width + result.rect.height * 8 ||
+                        candidate.rect.y >= result.rect.y + result.rect.height ||
+                        candidate.rect.y + candidate.rect.height <= result.rect.y) {
+                        continue;
+                    }
+                    if (number) {
+                        return std::nullopt;
+                    }
+                    number = parsed;
+                }
+            }
+            return number;
+        };
+        const auto total = labeled_number("总计支付");
+        const auto unit = labeled_number("售价");
+        // The two independent labels and a confirmed quantity of one must agree before payment.
+        return total && unit && *total > 0 && total == unit ? total : std::nullopt;
+    };
+    const auto price = read_price();
+    if (!price || !m_owner.sleep(300) || price != read_price()) {
+        report("blocked", "32001", required, "PurchasePriceUncertain");
+        return false;
+    }
+    const int balance = available("4006");
+    m_budget.advance_day(oper_progress::current_game_day());
+    if (!oper_progress::DailySupplyBudget::can_spend(
+            m_policy.red_voucher,
+            m_budget.red_voucher,
+            std::numeric_limits<int>::max(),
+            *price)) {
+        report("blocked", "32001", required, "RedVoucherBudgetReached");
+        return false;
+    }
+    if (balance < *price + m_policy.red_voucher.reserve) {
+        // Leave the unconfirmed store dialog through the normal stage navigation chain.
+        const int required_balance = *price + m_policy.red_voucher.reserve;
+        if (!prepare(m_name, { { "4006", required_balance } })) {
+            return false;
+        }
+        return purchase_catalyst(required);
+    }
+    if (!reserve_budget("red_voucher", *price, balance)) {
+        report("blocked", "32001", required, "RedVoucherBudgetReached");
+        return false;
+    }
+    report("red_voucher", "32001", 1);
+    // Buy one unit, then re-read inventory before scheduling another unit.
+    if (m_owner.need_exit() || !m_owner.run_task("RedTicket@Store@Purchase", 0) || !refresh_inventory()) {
+        return false;
+    }
+    settle_budget("red_voucher", *price, balance - available("4006"));
+    return m_budget_valid && !m_owner.need_exit();
+}
+
+std::optional<json::value> asst::OperProgressSupplyCoordinator::operator_data(const std::string& name) const
+{
+    const std::string role = enum_to_string(m_owner.m_current_role);
+    if (const auto operators = m_data->find_value("operators_by_id")) {
+        for (const auto& [_, entry] : operators->as_object()) {
+            if (entry.get("name", "") == name && entry.get("role", "") == role) {
+                return entry;
+            }
+        }
+    }
+    if (const auto entry = m_data->at("operators").find_value(name); entry && entry->get("role", "") == role) {
+        return *entry;
+    }
+    return std::nullopt;
+}
+
+asst::oper_progress::MaterialAmounts asst::OperProgressSupplyCoordinator::experience_books() const
+{
+    oper_progress::MaterialAmounts result;
+    for (const auto& [item, experience] : m_data->at("experience_items").as_object()) {
+        if (available(item) > 0) {
+            result[item] = experience.as_integer();
+        }
+    }
+    return result;
+}
+
+void asst::OperProgressSupplyCoordinator::report(
+    std::string phase,
+    std::string item,
+    int missing,
+    std::string reason,
+    std::string stage)
+{
+    auto info = m_owner.basic_info_with_what("OperProgressSupply");
+    info["details"] = json::object {
+        { "name", m_name },     { "phase", std::move(phase) }, { "item_id", std::move(item) },
+        { "missing", missing }, { "stage", std::move(stage) }, { "reason", std::move(reason) },
+    };
+    m_owner.callback(AsstMsg::SubTaskExtraInfo, info);
+}
