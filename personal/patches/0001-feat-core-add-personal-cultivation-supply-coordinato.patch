+
+bool valid_amounts(const json::value& value)
+{
+    return value.is_object() && std::ranges::all_of(value.as_object(), [](const auto& entry) {
+               return !entry.first.empty() && entry.second.template is<int>() && entry.second.as_integer() >= 0 &&
+                      entry.second.as_integer() <= 10'000'000;
+           });
+}
+
+std::optional<int> strict_number(const cv::Mat& image, const Rect& roi)
+{
+    OCRer ocr(image);
+    ocr.set_task_info("NumberOcrReplace");
+    ocr.set_roi(roi);
+    if (!ocr.analyze() || ocr.get_result().size() != 1) {
+        return std::nullopt;
+    }
+    return parse_material_number(ocr.get_result().front().text);
+}
