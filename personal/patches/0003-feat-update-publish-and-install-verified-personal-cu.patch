diff --git a/.github/workflows/personal-release.yml b/.github/workflows/personal-release.yml
new file mode 100644
index 0000000000..0e05f44448
--- /dev/null
+++ b/.github/workflows/personal-release.yml
@@ -0,0 +1,97 @@
+name: Personal cultivation releases
+
+on:
+  schedule:
+    - cron: "23 */6 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: write
+
+concurrency:
+  group: personal-cultivation-release
+  cancel-in-progress: false
+
+jobs:
+  discover:
+    if: github.repository == 'rsdadada/MaaAssistantArknights'
+    runs-on: ubuntu-latest
+    outputs:
+      matrix: ${{ steps.discovery.outputs.matrix }}
+      available: ${{ steps.discovery.outputs.available }}
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.13"
+      - name: Check release tooling
+        run: python -m unittest discover -s tools/PersonalRelease/tests -v
+      - name: Discover official stable, beta and resource changes
+        id: discovery
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          python tools/PersonalRelease/release.py discover --output candidates.json
+          python - <<'PY'
+          import json, os
+          data = json.load(open('candidates.json'))
+          with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
+              output.write('matrix=' + json.dumps(data, separators=(',', ':')) + '\n')
+              output.write('available=' + str(bool(data['include'])).lower() + '\n')
+          PY
+
+  build:
+    needs: discover
+    if: needs.discover.outputs.available == 'true'
+    strategy:
+      fail-fast: false
+      matrix: ${{ fromJSON(needs.discover.outputs.matrix) }}
+    runs-on: windows-2025-vs2026
+    env:
+      GH_TOKEN: ${{ github.token }}
+      PYTHONUTF8: "1"
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          path: maintenance
+      - uses: actions/setup-python@v6
+        with:
+          python-version: "3.13"
+      - uses: actions/setup-dotnet@v6
+        with:
+          dotnet-version: "10.0.302"
+      - name: Prepare pinned source and replay enhancement patches
+        env:
+          PERSONAL_JOB: ${{ toJSON(matrix) }}
+        run: |
+          git config --global core.longpaths true
+          gh auth setup-git
+          $env:PERSONAL_JOB | Set-Content -LiteralPath job.json -Encoding utf8
+          python maintenance/tools/PersonalRelease/release.py prepare --job job.json --workspace candidate
+      - name: Build and validate the exact resource combination
+        run: ./maintenance/tools/PersonalRelease/build.ps1 -Workspace candidate
+      - name: Package verified files
+        run: |
+          python maintenance/tools/PersonalRelease/release.py package --workspace candidate
+          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
+          $manifest = Get-ChildItem candidate/artifacts -Filter 'personal-*.json' | Select-Object -First 1
+          $package = Get-ChildItem candidate/artifacts -Filter '*.zip' | Select-Object -First 1
+          dotnet run --project candidate/source/tools/PersonalUpdateTests -c Release -- --verify $manifest.FullName $package.FullName
+      - name: Retain reviewable packages
+        uses: actions/upload-artifact@v7
+        with:
+          name: personal-${{ matrix.kind }}-${{ matrix.upstreamVersion }}-r${{ matrix.revision }}
+          path: candidate/artifacts/*
+          compression-level: 0
+      - name: Publish complete release
+        if: vars.PERSONAL_PUBLISH_ENABLED == 'true'
+        run: python maintenance/tools/PersonalRelease/release.py publish --workspace candidate
+      - name: Retain failure evidence
+        if: failure()
+        uses: actions/upload-artifact@v7
+        with:
+          name: failure-${{ matrix.kind }}-${{ matrix.upstreamVersion }}
+          path: |
+            candidate/validation/debug/*.log
+            candidate/source/build/personal-ci/CMakeFiles/CMakeConfigureLog.yaml
+          if-no-files-found: ignore
