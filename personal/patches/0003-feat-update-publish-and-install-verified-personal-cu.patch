index 0000000000..9dcd7ef882
--- /dev/null
+++ b/src/MaaWpfGui/Services/PersonalUpdateService.cs
@@ -0,0 +1,428 @@
+// <copyright file="PersonalUpdateService.cs" company="MaaAssistantArknights">
+// Part of the MaaWpfGui project, maintained by the MaaAssistantArknights team (Maa Team)
+// Copyright (C) 2021-2026 MaaAssistantArknights Contributors
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License v3.0 only as published by
+// the Free Software Foundation, either version 3 of the License, or
+// any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY
+// </copyright>
+
+#nullable enable
+
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Runtime.InteropServices;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using System.Threading;
+using System.Threading.Tasks;
+using MaaWpfGui.Helper;
+using MaaWpfGui.Main;
+using MaaWpfGui.Models;
+using MaaWpfGui.States;
+using MaaWpfGui.ViewModels.Dialogs;
+using MaaWpfGui.ViewModels.UI;
+using MaaWpfGui.ViewModels.UserControl.Settings;
+using Newtonsoft.Json.Linq;
+using Serilog;
+using Stylet;
+
+namespace MaaWpfGui.Services;
+
+public static class PersonalUpdateService
+{
+    public const string Repository = "rsdadada/MaaAssistantArknights";
+
+    private static readonly ILogger _logger = Log.ForContext(typeof(PersonalUpdateService));
+    private static readonly SemaphoreSlim _resourceUpdateLock = new(1, 1);
+    private static readonly Lazy<PersonalBuildIdentity?> _current = new(ReadCurrentIdentity);
+
+    private static string IdentityPath => Path.Combine(PathsHelper.BaseDir, "personal-build.json");
+
+    // A damaged identity must never silently switch the installation back to official updates.
+    public static bool IsEnabled => File.Exists(IdentityPath) || Directory.Exists(Path.Combine(PathsHelper.BaseDir, "personal"));
+
+    public static PersonalBuildIdentity? Current => _current.Value;
+
+    public static string? ActiveResourceRoot
+    {
+        get {
+            if (!IsEnabled || Current is not { } identity)
+            {
+                return null;
+            }
+
+            var manifest = ReadActiveResourceManifest(identity);
+            if (manifest is null)
+            {
+                return null;
+            }
+
+            var root = Path.Combine(GetBuildResourceRoot(identity), manifest.ResourceRevision.ToString(System.Globalization.CultureInfo.InvariantCulture));
+            return Directory.Exists(Path.Combine(root, "resource")) && Directory.Exists(Path.Combine(root, "personal", "resource")) ? root : null;
+        }
+    }
+
+    public static string EnhancementResourceDirectory => Path.Combine(ActiveResourceRoot ?? PathsHelper.BaseDir, "personal", "resource");
+
+    public static void ResetActiveResource(PersonalBuildIdentity identity)
+    {
+        var pointer = Path.Combine(GetBuildResourceRoot(identity), "active.json");
+        if (File.Exists(pointer))
+        {
+            File.Move(pointer, pointer + ".before-app-update", overwrite: true);
+        }
+    }
+
+    public sealed record AppRelease(PersonalReleaseManifest Manifest, string DownloadUrl, string HtmlUrl, string Notes);
+
+    public static async Task<AppRelease?> FindApplicationReleaseAsync(bool allowBeta, bool repair = false)
+    {
+        var current = Current ?? (repair
+            ? new PersonalBuildIdentity { UpstreamVersion = "v0.0.0", Revision = 0 }
+            : throw new InvalidDataException("Personal build identity is missing or invalid"));
+        if (RuntimeInformation.ProcessArchitecture != Architecture.X64)
+        {
+            throw new InvalidDataException("Personal updates require a Windows x64 process");
+        }
+
+        var releases = await GetReleasesAsync().ConfigureAwait(false);
+        var candidates = new List<(PersonalBuildIdentity Identity, JObject Release)>();
+        foreach (var release in releases)
+        {
+            var tag = release["tag_name"]?.ToString() ?? string.Empty;
+            var match = Regex.Match(tag, @"^personal/(v\d+\.\d+\.\d+(?:-beta\.\d+)?)-r(\d+)$", RegexOptions.CultureInvariant);
+            if (!match.Success || !int.TryParse(match.Groups[2].Value, out var revision) || revision <= 0
+                || !PersonalBuildIdentity.TryParseVersion(match.Groups[1].Value, out _, out var beta)
+                || (!allowBeta && beta.HasValue && !(repair && match.Groups[1].Value == current.UpstreamVersion && revision == current.Revision)))
+            {
+                continue;
+            }
+
+            var identity = new PersonalBuildIdentity { UpstreamVersion = match.Groups[1].Value, Revision = revision };
+            if (identity.CompareTo(current) > 0 || (repair && identity.CompareTo(current) == 0))
+            {
+                candidates.Add((identity, release));
+            }
+        }
+
+        candidates.Sort((a, b) => b.Identity.CompareTo(a.Identity));
+        foreach (var candidate in candidates)
+        {
+            var manifest = await ReadAssetJsonAsync<PersonalReleaseManifest>(candidate.Release, "personal-release.json").ConfigureAwait(false);
+            if (manifest is not { HasWindowsPackage: true } || manifest.UpstreamVersion != candidate.Identity.UpstreamVersion || manifest.Revision != candidate.Identity.Revision)
+            {
+                _logger.Warning("Ignoring invalid personal application release {Tag}", candidate.Release["tag_name"]);
+                continue;
+            }
+
+            var asset = FindAsset(candidate.Release, manifest.Packages["win-x64"].FileName);
+            if (asset is null)
+            {
+                continue;
+            }
+
+            return new AppRelease(manifest, GetAssetUrl(asset), candidate.Release["html_url"]?.ToString() ?? string.Empty, candidate.Release["body"]?.ToString() ?? string.Empty);
+        }
+
+        return null;
+    }
+
+    public static async Task<string?> DownloadApplicationAsync(AppRelease release)
+    {
+        var package = release.Manifest.Packages["win-x64"];
+        var path = await DownloadVerifiedAsync(release.DownloadUrl, package).ConfigureAwait(false);
+        if (path is null)
+        {
+            return null;
+        }
+
+        var identity = PersonalPackageValidation.ReadBuildIdentity(path);
+        if (identity is null || !identity.Matches(release.Manifest) || identity.ResourceCommit != release.Manifest.ResourceCommit)
+        {
+            throw new InvalidDataException("Application package identity does not match release manifest");
+        }
+
+        return path;
+    }
+
+    public static async Task<VersionUpdateDialogViewModel.CheckUpdateRetT> UpdateResourcesAsync()
+    {
+        if (!await _resourceUpdateLock.WaitAsync(0).ConfigureAwait(false))
+        {
+            return VersionUpdateDialogViewModel.CheckUpdateRetT.NoNeedToUpdate;
+        }
+
+        try
+        {
+            var current = Current ?? throw new InvalidDataException("Personal build identity is missing or invalid");
+            var releases = await GetReleasesAsync().ConfigureAwait(false);
+            var prefix = $"personal-resource/{current.BuildKey}/";
+            var candidates = releases.Select(release => (Release: release, Tag: release["tag_name"]?.ToString() ?? string.Empty))
+                .Where(value => value.Tag.StartsWith(prefix, StringComparison.Ordinal))
+                .Select(value => (value.Release, Revision: int.TryParse(value.Tag[prefix.Length..], out var revision) ? revision : 0))
+                .OrderByDescending(value => value.Revision);
+            var activeRevision = ReadActiveResourceManifest(current)?.ResourceRevision ?? 0;
+            foreach (var candidate in candidates)
+            {
+                if (candidate.Revision <= activeRevision)
+                {
+                    break;
+                }
+
+                if (File.Exists(Path.Combine(GetBuildResourceRoot(current), $"failed-{candidate.Revision}.json")))
+                {
+                    continue;
+                }
+
+                var manifest = await ReadAssetJsonAsync<PersonalResourceManifest>(candidate.Release, "personal-resource.json").ConfigureAwait(false);
+                if (manifest is null || !manifest.IsCompatibleWith(current) || manifest.ResourceRevision != candidate.Revision)
+                {
+                    continue;
+                }
+
+                var asset = FindAsset(candidate.Release, manifest.Package.FileName);
+                if (asset is null)
+                {
+                    continue;
+                }
+
+                VersionUpdateDialogViewModel.OutputDownloadProgress(LocalizationHelper.GetString("VersionUpdate.GameResource.Updating"));
+                var path = await DownloadVerifiedAsync(GetAssetUrl(asset), manifest.Package).ConfigureAwait(false);
+                if (path is null)
+                {
+                    return VersionUpdateDialogViewModel.CheckUpdateRetT.UpdatePackageDownloadFailed;
+                }
+
+                PersonalPackageValidation.ValidateResourceArchive(path);
+                await InstallResourcesAsync(path, manifest, current).ConfigureAwait(false);
+                Execute.OnUIThread(() => SettingsViewModel.VersionUpdateSettings.NewResourceFoundInfo = string.Empty);
+                VersionUpdateDialogViewModel.OutputDownloadProgress(LocalizationHelper.GetString("VersionUpdate.GameResource.Updated"), downloading: false);
+                return VersionUpdateDialogViewModel.CheckUpdateRetT.OnlyGameResourceUpdated;
+            }
+
+            return VersionUpdateDialogViewModel.CheckUpdateRetT.AlreadyLatest;
+        }
+        catch (Exception ex)
+        {
+            _logger.Error(ex, "Personal resource update failed; keeping the previously activated resource");
+            var message = LocalizationHelper.GetString("VersionUpdate.GameResource.Failed");
+            if (Bootstrapper.RequiresRestart)
+            {
+                message += "\n" + LocalizationHelper.GetString("Boot.RestartRecommendation");
+            }
+
+            VersionUpdateDialogViewModel.OutputDownloadProgress(message, downloading: false);
+            return VersionUpdateDialogViewModel.CheckUpdateRetT.UnknownError;
+        }
+        finally
+        {
+            _resourceUpdateLock.Release();
+        }
+    }
+
+    private static async Task InstallResourcesAsync(string zipPath, PersonalResourceManifest manifest, PersonalBuildIdentity identity)
+    {
+        var buildRoot = GetBuildResourceRoot(identity);
+        Directory.CreateDirectory(buildRoot);
+        var directory = Path.Combine(buildRoot, manifest.ResourceRevision.ToString(System.Globalization.CultureInfo.InvariantCulture));
+        var staging = Path.Combine(buildRoot, $"staging-{Guid.NewGuid():N}");
+        try
+        {
+            ZipFile.ExtractToDirectory(zipPath, staging);
+            if (Directory.Exists(directory))
+            {
+                // Re-extract into a fresh directory; never trust residue from an interrupted activation.
+                Directory.Move(directory, Path.Combine(buildRoot, $"unused-{Guid.NewGuid():N}"));
+            }
+
+            Directory.Move(staging, directory);
+
+            // Never hold the serialization lock while waiting for running tasks: their callbacks may need it.
+            while (true)
+            {
+                await RunningState.Instance.UntilIdleAsync().ConfigureAwait(false);
+                await TaskQueueViewModel.TaskQueueSerializingLock.WaitAsync().ConfigureAwait(false);
+                if (RunningState.Instance.GetIdle())
+                {
+                    break;
+                }
+
+                TaskQueueViewModel.TaskQueueSerializingLock.Release();
+            }
+
+            try
+            {
+                var pointerPath = Path.Combine(buildRoot, "active.json");
+                var previous = File.Exists(pointerPath) ? await File.ReadAllTextAsync(pointerPath).ConfigureAwait(false) : null;
+                try
+                {
+                    await WritePointerAsync(pointerPath, JsonSerializer.Serialize(manifest, PersonalPackageValidation.JsonOptions)).ConfigureAwait(false);
+                    if (!await Instances.AsstProxy.LoadResourceAsync().ConfigureAwait(false))
+                    {
+                        throw new InvalidDataException("Personal resource load failed");
+                    }
+                }
+                catch
+                {
+                    // Core incremental loads can have changed state before failing; restart with the old pointer.
+                    Bootstrapper.MarkRequiresRestart();
+                    try
+                    {
+                        if (previous is null)
+                        {
+                            File.Delete(pointerPath);
+                        }
+                        else
+                        {
+                            await WritePointerAsync(pointerPath, previous).ConfigureAwait(false);
+                        }
+
+                        await File.WriteAllTextAsync(Path.Combine(buildRoot, $"failed-{manifest.ResourceRevision}.json"),
+                            JsonSerializer.Serialize(manifest, PersonalPackageValidation.JsonOptions)).ConfigureAwait(false);
+                    }
+                    catch (Exception ex)
+                    {
+                        _logger.Error(ex, "Failed to restore personal resource pointer; full package repair is required");
+                    }
+
+                    throw;
+                }
+            }
+            finally
+            {
+                TaskQueueViewModel.TaskQueueSerializingLock.Release();
+            }
+        }
+        finally
+        {
+            if (Directory.Exists(staging))
+            {
+                Directory.Delete(staging, recursive: true);
+            }
+        }
+    }
+
+    private static async Task WritePointerAsync(string pointerPath, string value)
+    {
+        var temporary = pointerPath + ".tmp";
+        await File.WriteAllTextAsync(temporary, value).ConfigureAwait(false);
+        File.Move(temporary, pointerPath, overwrite: true);
+    }
+
+    private static string GetBuildResourceRoot(PersonalBuildIdentity identity) => Path.Combine(PathsHelper.CacheDir, "personal-resources", identity.BuildKey);
+
+    private static PersonalResourceManifest? ReadActiveResourceManifest(PersonalBuildIdentity identity)
+    {
+        try
+        {
+            var path = Path.Combine(GetBuildResourceRoot(identity), "active.json");
+            if (!File.Exists(path))
+            {
+                return null;
+            }
+
+            var manifest = JsonSerializer.Deserialize<PersonalResourceManifest>(File.ReadAllText(path), PersonalPackageValidation.JsonOptions);
+            return manifest is not null && manifest.IsCompatibleWith(identity) ? manifest : null;
+        }
+        catch (Exception ex)
+        {
+            _logger.Warning(ex, "Ignoring incompatible personal resource cache");
+            return null;
+        }
+    }
+
+    private static PersonalBuildIdentity? ReadCurrentIdentity()
+    {
+        try
+        {
+            if (!File.Exists(IdentityPath))
+            {
+                return null;
+            }
+
+            var identity = JsonSerializer.Deserialize<PersonalBuildIdentity>(File.ReadAllText(IdentityPath), PersonalPackageValidation.JsonOptions);
+            return identity is { IsValid: true } ? identity : null;
+        }
+        catch (Exception ex)
+        {
+            _logger.Error(ex, "Failed to read personal build identity");
+            return null;
+        }
+    }
+
+    private static async Task<List<JObject>> GetReleasesAsync()
+    {
+        var releases = new List<JObject>();
+        for (var page = 1; page <= 10; page++)
+        {
+            var text = await Instances.HttpService.GetStringAsync(new Uri($"https://api.github.com/repos/{Repository}/releases?per_page=100&page={page}")).ConfigureAwait(false)
+                ?? throw new IOException("Cannot query personal releases");
+            var entries = JArray.Parse(text);
+            releases.AddRange(entries.OfType<JObject>().Where(entry => entry["draft"]?.Value<bool>() != true));
+            if (entries.Count < 100)
+            {
+                return releases;
+            }
+        }
+
+        return releases;
+    }
+
+    private static JObject? FindAsset(JObject release, string name) => (release["assets"] as JArray)?.OfType<JObject>().SingleOrDefault(asset => asset["name"]?.ToString() == name);
+
+    private static string GetAssetUrl(JObject asset)
+    {
+        var value = asset["browser_download_url"]?.ToString() ?? string.Empty;
+        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri) || uri.Scheme != "https" || uri.Host != "github.com"
+            || !uri.AbsolutePath.StartsWith($"/{Repository}/releases/download/", StringComparison.Ordinal))
+        {
+            throw new InvalidDataException("Unexpected personal release asset URL");
+        }
+
+        return value;
+    }
+
+    private static async Task<T?> ReadAssetJsonAsync<T>(JObject release, string fileName)
+    {
+        var asset = FindAsset(release, fileName);
+        if (asset is null)
+        {
+            return default;
+        }
+
+        var value = await Instances.HttpService.GetStringAsync(new Uri(GetAssetUrl(asset))).ConfigureAwait(false);
+        return value is null ? default : JsonSerializer.Deserialize<T>(value, PersonalPackageValidation.JsonOptions);
+    }
+
+    private static async Task<string?> DownloadVerifiedAsync(string url, PersonalPackage package)
+    {
+        if (!package.IsValid)
+        {
+            throw new InvalidDataException("Invalid personal package metadata");
+        }
+
+        var directory = Path.Combine(PathsHelper.CacheDir, "personal-downloads");
+        Directory.CreateDirectory(directory);
+        var path = Path.Combine(directory, package.FileName);
+        if (!await Instances.HttpService.DownloadFileAsync(new Uri(url), path).ConfigureAwait(false))
+        {
+            return null;
+        }
+
+        if (!PersonalPackageValidation.VerifyHash(path, package.Sha256))
+        {
+            File.Delete(path);
+            throw new InvalidDataException("Personal package checksum mismatch");
+        }
+
+        return path;
+    }
+}
