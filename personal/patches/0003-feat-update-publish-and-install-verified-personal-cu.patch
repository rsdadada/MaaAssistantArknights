+
+#nullable enable
+
+using System;
+using System.IO;
+using System.IO.Compression;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text.Json;
+using MaaWpfGui.Models;
+
+namespace MaaWpfGui.Services;
+
+public static class PersonalPackageValidation
+{
+    public static JsonSerializerOptions JsonOptions { get; } = new() { PropertyNameCaseInsensitive = true, PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
+
+    public static bool VerifyHash(string path, string expectedHash)
+    {
+        using var stream = File.OpenRead(path);
+        return Convert.ToHexString(SHA256.HashData(stream)).Equals(expectedHash, StringComparison.OrdinalIgnoreCase);
+    }
+
+    public static PersonalBuildIdentity? ReadBuildIdentity(string packagePath)
+    {
+        using var archive = ZipFile.OpenRead(packagePath);
+        ValidatePaths(archive, resourcesOnly: false);
+        foreach (var required in new[] { "personal-build.json", "MAA.exe", "MaaCore.dll", "MAA.Updater.exe", "resource/version.json", "personal/resource/cultivation.json" })
+        {
+            if (archive.GetEntry(required) is not { Length: > 0 })
+            {
+                throw new InvalidDataException($"Personal package is missing {required}");
+            }
+        }
+
+        if (archive.GetEntry("changes.json") is not null || archive.GetEntry("removelist.txt") is not null)
+        {
+            throw new InvalidDataException("Personal application updates must be full packages");
+        }
+
+        using var stream = archive.GetEntry("personal-build.json")!.Open();
+        var identity = JsonSerializer.Deserialize<PersonalBuildIdentity>(stream, JsonOptions);
+        return identity is { IsValid: true } ? identity : null;
+    }
+
+    public static void ValidateResourceArchive(string packagePath)
+    {
+        using var archive = ZipFile.OpenRead(packagePath);
+        ValidatePaths(archive, resourcesOnly: true);
+        foreach (var required in new[] { "resource/version.json", "resource/item_index.json", "resource/battle_data.json", "personal/resource/cultivation.json" })
+        {
+            if (archive.GetEntry(required) is not { Length: > 0 })
+            {
+                throw new InvalidDataException($"Personal resource package is missing {required}");
+            }
+        }
+
+        if (!archive.Entries.Any(entry => entry.FullName.StartsWith("resource/tasks/", StringComparison.Ordinal)))
+        {
+            throw new InvalidDataException("Personal resource package is missing tasks");
+        }
+    }
+
+    private static void ValidatePaths(ZipArchive archive, bool resourcesOnly)
+    {
+        var names = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        foreach (var entry in archive.Entries)
+        {
+            var name = entry.FullName;
+            if (string.IsNullOrEmpty(name) || name.Contains('\\') || name.Contains(':') || name.StartsWith('/')
+                || name.Split('/').Any(part => part is "." or ".." || part.EndsWith(' ') || part.EndsWith('.'))
+                || ((entry.ExternalAttributes >> 16) & 0xF000) == 0xA000
+                || !names.Add(name))
+            {
+                throw new InvalidDataException("Invalid archive path");
+            }
+
+            if (resourcesOnly && name != "resource/" && name != "personal/"
+                && !name.StartsWith("resource/", StringComparison.Ordinal)
+                && !name.StartsWith("personal/resource/", StringComparison.Ordinal))
+            {
+                throw new InvalidDataException("Unexpected file in resource package");
+            }
+        }
+    }
+}
diff --git a/src/MaaWpfGui/Services/PersonalUpdateService.cs b/src/MaaWpfGui/Services/PersonalUpdateService.cs
