+// but WITHOUT ANY WARRANTY
+// </copyright>
+
+#nullable enable
+
+using System;
+using System.Threading.Tasks;
+using MaaWpfGui.Helper;
+using MaaWpfGui.Services;
+using MaaWpfGui.ViewModels.UI;
+using MaaWpfGui.ViewModels.UserControl.Settings;
+
+namespace MaaWpfGui.ViewModels.Dialogs;
+
+public partial class VersionUpdateDialogViewModel
+{
+    private async Task<CheckUpdateRetT> HandlePersonalUpdateAsync(bool repair = false)
+    {
+        try
+        {
+            var allowBeta = SettingsViewModel.VersionUpdateSettings.VersionType != VersionUpdateSettingsUserControlModel.UpdateVersionType.Stable;
+            var release = await PersonalUpdateService.FindApplicationReleaseAsync(allowBeta, repair);
+            if (release is null)
+            {
+                return repair ? CheckUpdateRetT.FailedToGetInfo : CheckUpdateRetT.AlreadyLatest;
+            }
+
+            UpdateTag = release.Manifest.DisplayVersion;
+            UpdateInfo = release.Notes;
+            UpdateUrl = release.HtmlUrl;
+            SettingsViewModel.VersionUpdateSettings.NewVersionFoundInfo = $"{LocalizationHelper.GetString("VersionUpdate.NewVersionFound.Title")}: {UpdateTag}";
+            ShowUpdateInfo(true, LocalizationHelper.GetString("VersionUpdate.NewVersionFound.GoWebpage"), true);
+            if (!repair && !SettingsViewModel.VersionUpdateSettings.AutoDownloadUpdatePackage)
+            {
+                return CheckUpdateRetT.NoNeedToUpdate;
+            }
+
+            var packagePath = await PersonalUpdateService.DownloadApplicationAsync(release);
+            if (packagePath is null)
+            {
+                return CheckUpdateRetT.UpdatePackageDownloadFailed;
+            }
+
+            // Manifest identity, SHA-256 and full archive contents were checked before registration.
+            // The upstream filename comparer cannot order personal revisions of the same release.
+            var inspection = new PendingUpdateApplier.PackageInspectionResult(
+                PendingUpdateApplier.PackageInspectionStatus.FullSupported,
+                TargetVersion: release.Manifest.DisplayVersion);
+            var registration = PendingUpdateApplier.TryRegisterLocalPackage(packagePath, _curVersion, "x64", inspection, allowSameVersion: repair);
+            if (registration.Status != PendingUpdateApplier.LocalPackageImportStatus.FullPackageRegistered)
+            {
+                return CheckUpdateRetT.UpdatePackageDownloadFailed;
+            }
+
+            UpdatePackageName = packagePath;
+            OutputDownloadProgress(LocalizationHelper.GetString("VersionUpdate.NewVersionDownloadCompleted.Title"), downloading: false);
+            return CheckUpdateRetT.OK;
+        }
+        catch (Exception ex)
+        {
+            _logger.Error(ex, "Personal application update failed; official fallback is disabled");
+            OutputDownloadProgress(LocalizationHelper.GetString("VersionUpdate.NewVersionDownloadFailed.Title"), downloading: false);
+            return CheckUpdateRetT.FailedToGetInfo;
+        }
+    }
+}
