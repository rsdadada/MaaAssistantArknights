+
+using System.IO.Compression;
+using System.Security.Cryptography;
+using System.Text.Json;
+using MaaWpfGui.Models;
+using MaaWpfGui.Services;
+
+if (args is ["--verify", var manifestPath, var zipPath])
+{
+    using var document = JsonDocument.Parse(File.ReadAllText(manifestPath));
+    if (document.RootElement.TryGetProperty("packages", out _))
+    {
+        var manifest = JsonSerializer.Deserialize<PersonalReleaseManifest>(document, PersonalPackageValidation.JsonOptions)
+            ?? throw new InvalidDataException("Application manifest is missing");
+        if (!manifest.HasWindowsPackage || manifest.Packages["win-x64"].FileName != Path.GetFileName(zipPath)
+            || !PersonalPackageValidation.VerifyHash(zipPath, manifest.Packages["win-x64"].Sha256)
+            || PersonalPackageValidation.ReadBuildIdentity(zipPath) is not { } packaged || !packaged.Matches(manifest)
+            || packaged.ResourceCommit != manifest.ResourceCommit)
+        {
+            throw new InvalidDataException("Application release does not match client requirements");
+        }
+    }
+    else
+    {
+        var manifest = JsonSerializer.Deserialize<PersonalResourceManifest>(document, PersonalPackageValidation.JsonOptions)
+            ?? throw new InvalidDataException("Resource manifest is missing");
+        if (manifest.SchemaVersion != 1 || manifest.Revision < 1 || manifest.ResourceRevision < 1
+            || !PersonalBuildIdentity.TryParseVersion(manifest.UpstreamVersion, out _, out _)
+            || !manifest.Package.IsValid || manifest.Package.FileName != Path.GetFileName(zipPath)
+            || !PersonalPackageValidation.VerifyHash(zipPath, manifest.Package.Sha256))
+        {
+            throw new InvalidDataException("Resource release does not match client requirements");
+        }
+
+        PersonalPackageValidation.ValidateResourceArchive(zipPath);
+    }
+
+    Console.WriteLine("Release manifest and ZIP passed the actual client validators.");
+    return;
+}
+
+var passed = 0;
+void Check(bool condition, string name)
+{
+    if (!condition)
+    {
+        throw new InvalidOperationException(name);
+    }
+
+    Console.WriteLine($"PASS {name}");
+    passed++;
+}
+
+PersonalBuildIdentity Build(string version, int revision = 1) => new()
+{
+    SchemaVersion = 1,
+    Architecture = "win-x64",
+    UpstreamVersion = version,
+    Revision = revision,
+    UpstreamCommit = new string('a', 40),
+    SourceCommit = new string('b', 40),
+    ResourceCommit = new string('c', 40),
+};
+
+var current = Build("v6.21.1");
+Check(current.IsValid, "valid build identity");
+Check(Build("v6.21.1", 2).CompareTo(current) > 0, "same upstream personal revision upgrade");
+Check(Build("v6.21.1-beta.9", 99).CompareTo(current) < 0, "beta transitions to corresponding stable");
+Check(Build("v6.22.0-beta.1").CompareTo(current) > 0, "next beta newer than previous stable");
+Check(Build("v6.21.0", 99).CompareTo(current) < 0, "personal revision cannot override upstream ordering");
+Check(!Build("v6.21.2-alpha.1.d3.gabcdef0").IsValid, "nightly excluded");
+Check(!Build("v6.21.1/../../evil").IsValid, "invalid version cannot escape cache");
+Check(!Build("v9999999999999999999999.0.0").IsValid, "version overflow rejected");
+Check(!Build("v6.21.1", 0).IsValid, "zero revision rejected");
+var arm = Build("v6.21.1");
+arm.Architecture = "win-arm64";
+Check(!arm.IsValid, "unsupported architecture rejected");
+var resource = new PersonalResourceManifest
+{
+    SchemaVersion = 1,
+    UpstreamVersion = current.UpstreamVersion,
+    Revision = current.Revision,
+    ResourceRevision = 2,
+    ResourceCommit = new string('d', 40),
+    Package = new PersonalPackage { FileName = "resources.zip", Sha256 = new string('0', 64) },
+};
+Check(resource.IsCompatibleWith(current), "resource matches exact build");
+Check(!resource.IsCompatibleWith(Build("v6.21.1", 2)), "resource revision compatibility excludes another personal build");
+Check(!resource.IsCompatibleWith(Build("v6.21.2")), "resource cannot overwrite another upstream version");
+Check(!new PersonalPackage { FileName = "../outside.zip", Sha256 = new string('0', 64) }.IsValid, "package path traversal rejected");
+Check(!new PersonalPackage { FileName = "C:outside.zip", Sha256 = new string('0', 64) }.IsValid, "Windows drive path rejected");
+Check(!new PersonalPackage { FileName = "ok.zip", Sha256 = "1234" }.IsValid, "short checksum rejected");
+
+var temporary = Path.Combine(Path.GetTempPath(), $"maa-personal-update-tests-{Guid.NewGuid():N}");
+Directory.CreateDirectory(temporary);
+try
+{
+    string MakeZip(string name, params (string Path, string Contents)[] entries)
+    {
+        var path = Path.Combine(temporary, name);
+        using var archive = ZipFile.Open(path, ZipArchiveMode.Create);
+        foreach (var entry in entries)
+        {
+            using var writer = new StreamWriter(archive.CreateEntry(entry.Path).Open());
+            writer.Write(entry.Contents);
+        }
+
+        return path;
+    }
+
+    var identityJson = JsonSerializer.Serialize(current, PersonalPackageValidation.JsonOptions);
+    var appEntries = new[]
+    {
+        ("personal-build.json", identityJson), ("MAA.exe", "binary"), ("MaaCore.dll", "binary"),
+        ("MAA.Updater.exe", "binary"), ("resource/version.json", "{}"), ("personal/resource/cultivation.json", "{}"),
+    };
+    var package = MakeZip("app.zip", appEntries);
+    Check(PersonalPackageValidation.ReadBuildIdentity(package)?.Matches(current) == true, "full package identity validation");
+    var hash = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(package)));
+    Check(PersonalPackageValidation.VerifyHash(package, hash), "download SHA-256 accepted");
+    Check(!PersonalPackageValidation.VerifyHash(package, new string('0', 64)), "corrupted download rejected");
+
+    void Reject(string path, Action<string> validate, string name)
+    {
+        try
+        {
+            validate(path);
+        }
+        catch (InvalidDataException)
+        {
+            Check(true, name);
+            return;
+        }
+
+        Check(false, name);
+    }
+
+    Reject(MakeZip("official.zip", appEntries.Where(e => e.Item1 != "personal-build.json").ToArray()), path => PersonalPackageValidation.ReadBuildIdentity(path), "official package cannot replace enhanced build");
+    Reject(MakeZip("ota.zip", [.. appEntries, ("changes.json", "{}")]), path => PersonalPackageValidation.ReadBuildIdentity(path), "OTA rejected by full package channel");
+    Reject(MakeZip("traversal.zip", [.. appEntries, ("../outside.txt", "bad")]), path => PersonalPackageValidation.ReadBuildIdentity(path), "archive path traversal rejected");
+    Reject(MakeZip("duplicate.zip", [.. appEntries, ("maa.exe", "bad")]), path => PersonalPackageValidation.ReadBuildIdentity(path), "case-insensitive archive collision rejected");
+    Reject(MakeZip("resource-executable.zip", ("MAA.exe", "bad")), PersonalPackageValidation.ValidateResourceArchive, "resource archive cannot replace binaries");
+    Reject(MakeZip("partial-resource.zip", ("resource/version.json", "{}")), PersonalPackageValidation.ValidateResourceArchive, "partial resources rejected");
+    var resourceZip = MakeZip("resource.zip", ("resource/version.json", "{}"), ("resource/item_index.json", "{}"),
+        ("resource/battle_data.json", "{}"), ("resource/tasks/test.json", "{}"), ("personal/resource/cultivation.json", "{}"));
+    PersonalPackageValidation.ValidateResourceArchive(resourceZip);
+    Check(true, "complete resource bundle accepted");
+}
+finally
+{
+    Directory.Delete(temporary, recursive: true);
+}
+
+Console.WriteLine($"{passed} personal update checks passed.");
