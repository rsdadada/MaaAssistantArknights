+}
+
+var assemblyDirectory = Path.GetDirectoryName(guiPath)!;
+var resolver = new AssemblyDependencyResolver(guiPath);
+AssemblyLoadContext.Default.Resolving += (_, name) =>
+{
+    var resolved = resolver.ResolveAssemblyToPath(name);
+    foreach (var path in new[] { resolved, Path.Combine(assemblyDirectory, name.Name + ".dll"), Path.Combine(assemblyDirectory, "externals", name.Name + ".dll") })
+    {
+        if (path is not null && File.Exists(path))
+        {
+            return AssemblyLoadContext.Default.LoadFromAssemblyPath(path);
+        }
+    }
+
+    return null;
+};
+
+var assembly = AssemblyLoadContext.Default.LoadFromAssemblyPath(guiPath);
+var applier = assembly.GetType("MaaWpfGui.Services.PendingUpdateApplier", throwOnError: true)!;
+var contextType = applier.GetNestedType("PendingUpdateContext", BindingFlags.NonPublic)!;
+var pathsHelper = assembly.GetType("MaaWpfGui.Helper.PathsHelper", throwOnError: true)!;
+var packageValidation = assembly.GetType("MaaWpfGui.Services.PersonalPackageValidation", throwOnError: true)!;
+var personalService = assembly.GetType("MaaWpfGui.Services.PersonalUpdateService", throwOnError: true)!;
+var testRoot = Path.Combine(Path.GetFullPath(outputPath), $"installer-{Guid.NewGuid():N}");
+Directory.CreateDirectory(testRoot);
+
+object? Invoke(string name, params object?[] arguments)
+{
+    var method = applier.GetMethod(name, BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static)
+        ?? throw new MissingMethodException(applier.FullName, name);
+    return method.Invoke(null, arguments);
+}
+
+void Check(bool condition, string message)
+{
+    if (!condition)
+    {
+        throw new InvalidOperationException(message);
+    }
+
+    Console.WriteLine($"PASS {message}");
+}
+
+string BuildIdentity(int revision) => JsonSerializer.Serialize(new
+{
+    schemaVersion = 1,
+    architecture = "win-x64",
+    upstreamVersion = "v6.21.1",
+    upstreamCommit = new string('a', 40),
+    sourceCommit = new string('b', 40),
+    resourceCommit = new string('c', 40),
+    revision,
+});
+
+void Write(string root, string relative, string contents)
+{
+    var path = Path.Combine(root, relative);
+    Directory.CreateDirectory(Path.GetDirectoryName(path)!);
+    File.WriteAllText(path, contents, new UTF8Encoding(false));
+}
+
+foreach (var repair in new[] { false, true })
+{
+    var scenario = repair ? "same-build-repair" : "personal-revision-upgrade";
+    var root = Path.Combine(testRoot, scenario);
+    Directory.CreateDirectory(root);
+    var targetRevision = repair ? 1 : 2;
+    var identity = BuildIdentity(targetRevision);
+    Write(root, "personal-build.json", BuildIdentity(1));
+    Write(root, "MAA.exe", "old launcher");
+    Write(root, "MaaCore.dll", "old core");
+    Write(root, "old-unused.dll", "stale dependency");
+    Write(root, "personal/resource/cultivation.json", "old cultivation data");
+    Write(root, "resource/version.json", "old resources");
+    Write(root, "Res/Backgrounds/Wallpapers/my-wallpaper.png", "user wallpaper");
+    Write(root, "Res/old-content.txt", "obsolete bundled resource");
+    var preserved = new Dictionary<string, string>
+    {
+        ["config/gui.new.json"] = "{\"plans\":[\"四星培养\"],\"userSetting\":true}",
+        ["data/personal-cultivation/budget.json"] = "{\"creditSpent\":120,\"redVoucherSpent\":90}",
+        ["cache/user-cache.txt"] = "existing cache",
+        ["debug/user.log"] = "existing diagnostic log",
+        ["achievement/unlocks.json"] = "[1,2,3]",
+    };
+    foreach (var pair in preserved)
+    {
+        Write(root, pair.Key, pair.Value);
+    }
+
+    var activeResource = $"cache/personal-resources/v6.21.1-r{targetRevision}/active.json";
+    Write(root, activeResource, "stale resource pointer");
+    var packagePath = Path.Combine(root, $"MAA-v6.21.1-personal.{targetRevision}-win-x64.zip");
+    using (var archive = ZipFile.Open(packagePath, ZipArchiveMode.Create))
+    {
+        var payload = new Dictionary<string, string>
+        {
+            ["MAA.exe"] = "new launcher",
+            ["MaaCore.dll"] = "new core",
+            ["personal-build.json"] = identity,
+            ["resource/version.json"] = "new resources",
+            ["personal/resource/cultivation.json"] = "new cultivation data",
+            ["personal/resource/tasks/培养.json"] = "new enhancement task",
+            ["Res/Backgrounds/Wallpapers/new-wallpaper.png"] = "new bundled wallpaper",
+            ["config/gui.new.json"] = "must not replace user configuration",
+            ["data/personal-cultivation/budget.json"] = "must not reset budget",
+            ["cache/user-cache.txt"] = "must not replace cache",
+        };
+        foreach (var pair in payload)
+        {
+            using var writer = new StreamWriter(archive.CreateEntry(pair.Key).Open(), new UTF8Encoding(false));
+            writer.Write(pair.Value);
+        }
+
+        archive.CreateEntryFromFile(updaterPath, "MAA.Updater.exe");
+    }
+
+    // Each fixture represents a fresh app process, including its memoized directory helpers.
+    foreach (var field in pathsHelper.GetFields(BindingFlags.NonPublic | BindingFlags.Static).Where(field => field.FieldType == typeof(string) && !field.IsInitOnly))
+    {
+        field.SetValue(null, null);
+    }
+
+    pathsHelper.GetField("_base", BindingFlags.NonPublic | BindingFlags.Static)!.SetValue(null, root);
+    var inspection = Invoke("InspectLocalUpdatePackage", packagePath, "v6.21.1", "x64", repair)!;
+    Check(inspection.GetType().GetProperty("Status")!.GetValue(inspection)!.ToString() == "FullSupported", $"{scenario}: production personal package inspection");
+    var packageIdentity = packageValidation.GetMethod("ReadBuildIdentity")!.Invoke(null, [packagePath])!;
+    personalService.GetMethod("ResetActiveResource")!.Invoke(null, [packageIdentity]);
+    Check(!File.Exists(Path.Combine(root, activeResource)), $"{scenario}: incompatible resource pointer reset");
+    Check(File.Exists(Path.Combine(root, activeResource + ".before-app-update")), $"{scenario}: resource pointer retained for diagnosis");
+
+    var extract = Path.Combine(root, "NewVersionExtract");
+    var backup = Path.Combine(root, ".old");
+    Invoke("PrepareExtractDirectory", extract);
+    Invoke("ExtractPendingUpdatePackage", packagePath, extract);
+    var context = Activator.CreateInstance(contextType, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic,
+        binder: null, args: [root, packagePath, extract, backup], culture: null)!;
+    var removeEntries = (string[])Invoke("GetFullPackageRemoveEntries", context)!;
+    var moveEntries = (string[])Invoke("GetFullPackageMoveEntries", extract)!;
+    var plan = (string)Invoke("CreatePendingUpdatePlan", "full", removeEntries, moveEntries, Array.Empty<string>())!;
+    var planPath = Path.Combine(root, "test-update-plan.json");
+    File.WriteAllText(planPath, plan, new UTF8Encoding(false));
+    var executable = (string)Invoke("PrepareDelegatedUpdaterExecutable", context)!;
+    var successPath = Path.Combine(root, "pending-update-success.txt");
+    var failurePath = Path.Combine(root, "pending-update-failure.txt");
+    var start = new ProcessStartInfo(executable)
+    {
+        UseShellExecute = false,
+        CreateNoWindow = true,
+        WorkingDirectory = root,
+    };
+    foreach (var argument in new[] { "0", root, extract, backup, packagePath, successPath, failurePath, Path.Combine(root, "do-not-relaunch.exe"), planPath, "--no-progress-ui" })
+    {
+        start.ArgumentList.Add(argument);
+    }
+
+    using var process = Process.Start(start) ?? throw new InvalidOperationException("Native updater did not start");
+    try
+    {
+        await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(60));
+    }
+    catch (TimeoutException)
+    {
+        process.Kill(entireProcessTree: true);
+        throw;
+    }
+
+    Check(process.ExitCode == 0 && File.Exists(successPath) && !File.Exists(failurePath), $"{scenario}: native updater reports success");
+    Check(File.ReadAllText(Path.Combine(root, "MAA.exe")) == "new launcher", $"{scenario}: launcher replaced");
+    Check(File.ReadAllText(Path.Combine(root, "MaaCore.dll")) == "new core", $"{scenario}: Core replaced");
+    Check(File.ReadAllText(Path.Combine(root, "personal-build.json")) == identity, $"{scenario}: target build identity installed");
+    Check(File.ReadAllText(Path.Combine(root, "personal/resource/cultivation.json")) == "new cultivation data", $"{scenario}: enhancement resources replaced");
+    Check(File.Exists(Path.Combine(root, "personal/resource/tasks/培养.json")), $"{scenario}: Unicode enhancement task installed");
+    Check(!File.Exists(Path.Combine(root, "old-unused.dll")), $"{scenario}: obsolete runtime removed");
+    Check(File.ReadAllText(Path.Combine(backup, "MAA.exe")) == "old launcher", $"{scenario}: old runtime backed up");
+    foreach (var pair in preserved)
+    {
+        Check(File.ReadAllText(Path.Combine(root, pair.Key)) == pair.Value, $"{scenario}: preserves {pair.Key}");
+    }
+
+    Check(File.ReadAllText(Path.Combine(root, "Res/Backgrounds/Wallpapers/my-wallpaper.png")) == "user wallpaper", $"{scenario}: custom wallpaper preserved");
+    Check(File.ReadAllText(Path.Combine(root, "Res/Backgrounds/Wallpapers/new-wallpaper.png")) == "new bundled wallpaper", $"{scenario}: new wallpaper installed");
+    Check(!Directory.Exists(extract) && !File.Exists(packagePath), $"{scenario}: consumed update cleaned up");
+}
+
+Console.WriteLine($"Real GUI package preparation and native full-package installation passed. Evidence: {testRoot}");
