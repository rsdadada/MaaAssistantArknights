@@ -0,0 +1,99 @@
+// <copyright file="PersonalBuildIdentity.cs" company="MaaAssistantArknights">
+// Part of the MaaWpfGui project, maintained by the MaaAssistantArknights team (Maa Team)
+// Copyright (C) 2021-2026 MaaAssistantArknights Contributors
+//
+// This program is free software: you can redistribute it and/or modify
+// it under the terms of the GNU Affero General Public License v3.0 only as published by
+// the Free Software Foundation, either version 3 of the License, or
+// any later version.
+//
+// This program is distributed in the hope that it will be useful,
+// but WITHOUT ANY WARRANTY
+// </copyright>
+
+#nullable enable
+
+using System;
+using System.IO;
+using System.Text.RegularExpressions;
+
+namespace MaaWpfGui.Models;
+
+public class PersonalBuildIdentity
+{
+    public int SchemaVersion { get; set; }
+
+    public string UpstreamVersion { get; set; } = string.Empty;
+
+    public string UpstreamCommit { get; set; } = string.Empty;
+
+    public int Revision { get; set; }
+
+    public string Architecture { get; set; } = string.Empty;
+
+    public string SourceCommit { get; set; } = string.Empty;
+
+    public string ResourceCommit { get; set; } = string.Empty;
+
+    public string BuildKey => $"{UpstreamVersion}-r{Revision}";
+
+    public string DisplayVersion => $"{UpstreamVersion} + personal.{Revision}";
+
+    public bool IsValid => SchemaVersion == 1 && Architecture == "win-x64" && Revision > 0 && TryParseVersion(UpstreamVersion, out _, out _)
+        && IsCommit(UpstreamCommit) && IsCommit(SourceCommit) && IsCommit(ResourceCommit);
+
+    public bool IsBeta => TryParseVersion(UpstreamVersion, out _, out var beta) && beta.HasValue;
+
+    public bool Matches(PersonalBuildIdentity other) => IsValid && other.IsValid
+        && UpstreamVersion == other.UpstreamVersion && Revision == other.Revision
+        && UpstreamCommit == other.UpstreamCommit && SourceCommit == other.SourceCommit;
+
+    public int CompareTo(PersonalBuildIdentity other)
+    {
+        if (!TryParseVersion(UpstreamVersion, out var version, out var beta)
+            || !TryParseVersion(other.UpstreamVersion, out var otherVersion, out var otherBeta))
+        {
+            throw new InvalidDataException("Invalid personal build version");
+        }
+
+        var comparison = version.CompareTo(otherVersion);
+        if (comparison != 0)
+        {
+            return comparison;
+        }
+
+        comparison = (beta, otherBeta) switch {
+            (null, not null) => 1,
+            (not null, null) => -1,
+            (int a, int b) => a.CompareTo(b),
+            _ => 0,
+        };
+        return comparison != 0 ? comparison : Revision.CompareTo(other.Revision);
+    }
+
+    public static bool TryParseVersion(string? text, out Version version, out int? beta)
+    {
+        version = new Version(0, 0, 0);
+        beta = null;
+        var match = Regex.Match(text ?? string.Empty, @"^v(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-beta\.(0|[1-9]\d*))?$", RegexOptions.CultureInvariant);
+        if (!match.Success || !Version.TryParse($"{match.Groups[1].Value}.{match.Groups[2].Value}.{match.Groups[3].Value}", out var parsed))
+        {
+            return false;
+        }
+
+        if (match.Groups[4].Success)
+        {
+            if (!int.TryParse(match.Groups[4].Value, out var parsedBeta))
+            {
+                return false;
+            }
+
+            beta = parsedBeta;
+        }
+
+        version = parsed;
+        return true;
+    }
+
+    private static bool IsCommit(string? commit) => Regex.IsMatch(commit ?? string.Empty, @"^(?:[0-9a-f]{40}|[0-9a-f]{64})$", RegexOptions.CultureInvariant);
+}
