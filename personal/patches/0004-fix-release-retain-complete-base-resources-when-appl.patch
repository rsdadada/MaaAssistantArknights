From: rsdadada <rsddadada@outlook.com>
Date: Mon, 2 Nov 2026 17:58:52 +0000
Subject: [PATCH] fix(release): retain complete base resources when applying
 hot updates

---
 tools/PersonalRelease/release.py            | 17 +++++++++---
 tools/PersonalRelease/tests/test_release.py | 29 +++++++++++++++++++++
 2 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/tools/PersonalRelease/release.py b/tools/PersonalRelease/release.py
index 591175c41b..f62b444329 100644
--- a/tools/PersonalRelease/release.py
+++ b/tools/PersonalRelease/release.py
@@ -264,6 +264,16 @@ def extract_repository(archive: Path, destination: Path):
                     shutil.copyfileobj(incoming, output)
 
 
+def merge_resources(base: Path, overlay: Path):
+    # MaaResource is a hot-update layer, not a complete installation: models and
+    # other binary resources must remain pinned to the official application tag.
+    if not base.is_dir() or not overlay.is_dir():
+        raise ValueError(
+            "Both the complete resource base and hot-update layer are required"
+        )
+    shutil.copytree(overlay, base, dirs_exist_ok=True)
+
+
 def prepare(root: Path, config: dict, job: dict, workspace: Path):
     workspace.mkdir(parents=True, exist_ok=False)
     source = workspace / "source"
@@ -307,13 +317,12 @@ def prepare(root: Path, config: dict, job: dict, workspace: Path):
         resource_zip,
     )
     extract_repository(resource_zip, workspace / "resource-source")
-    # Replace the official resource snapshot in the isolated checkout only. This
-    # directory was just created above; no caller-controlled install path is used.
+    # Overlay the hot-update snapshot onto the complete resources from the pinned
+    # application tag. Resource-only builds use their compatible personal app tag.
     resource_dir = (source / "resource").resolve()
     if not resource_dir.is_relative_to(workspace.resolve()):
         raise ValueError("Resource destination escaped workspace")
-    shutil.rmtree(resource_dir)
-    shutil.copytree(workspace / "resource-source/resource", resource_dir)
+    merge_resources(resource_dir, workspace / "resource-source/resource")
     data = workspace / "gamedata"
     for name in DATA_FILES:
         download(
diff --git a/tools/PersonalRelease/tests/test_release.py b/tools/PersonalRelease/tests/test_release.py
index 350037e6b3..62b11b8838 100644
--- a/tools/PersonalRelease/tests/test_release.py
+++ b/tools/PersonalRelease/tests/test_release.py
@@ -64,6 +64,35 @@ class ReleaseTests(unittest.TestCase):
                 release.package(root)
             self.assertEqual(list((root / "artifacts").iterdir()), [])
 
+    def test_resource_overlay_preserves_models_and_updates_resources(self):
+        with tempfile.TemporaryDirectory() as temp:
+            root = Path(temp)
+            base = root / "resource"
+            overlay = root / "hot-resource"
+            original = {
+                "onnx/skill_ready_cls.onnx": "bundled skill model",
+                "PaddleOCR/det/inference.onnx": "bundled OCR detector",
+                "PaddleOCR/rec/inference.onnx": "bundled OCR recognizer",
+                "tasks/tasks.json": "old tasks",
+                "version.json": "old version",
+            }
+            updates = {
+                "tasks/tasks.json": "updated tasks",
+                "version.json": "updated version",
+                "template/new-item.png": "new item template",
+            }
+            for directory, contents in ((base, original), (overlay, updates)):
+                for name, content in contents.items():
+                    path = directory / name
+                    path.parent.mkdir(parents=True, exist_ok=True)
+                    path.write_bytes(content.encode())
+
+            release.merge_resources(base, overlay)
+
+            for name, content in (original | updates).items():
+                with self.subTest(resource=name):
+                    self.assertEqual((base / name).read_bytes(), content.encode())
+
     def test_missing_artifacts_never_create_release_or_push_tag(self):
